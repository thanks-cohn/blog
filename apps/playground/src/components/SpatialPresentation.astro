---
export interface Props {
  config: any;
  homeHref: string;
  links: Record<string, string>;
}

const { config, homeHref, links } = Astro.props;

type DiscoveredAsset = { name: string; url: string; kind: "2d" | "3d" };

const discovered2d = import.meta.glob("../assets/2d-assets/*.{png,jpg,jpeg,webp,avif,svg}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discovered3d = import.meta.glob("../assets/3d-assets/*.{glb,gltf}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const assetsByArtwork: Record<string, DiscoveredAsset[]> = {};

function registerAsset(path: string, url: string, kind: "2d" | "3d") {
  const file = path.split("/").pop() ?? "";
  const base = file.replace(/\.[^.]+$/, "");
  const match = base.match(/^(.*?)-(\d+)$/);
  if (!match) return;
  const artworkName = match[1];
  (assetsByArtwork[artworkName] ??= []).push({ name: file, url, kind });
}

for (const [path, url] of Object.entries(discovered2d)) registerAsset(path, url, "2d");
for (const [path, url] of Object.entries(discovered3d)) registerAsset(path, url, "3d");

const runtimeConfig = { ...config, assetsByArtwork, resolvedLinks: links };
---

<div
  class="presentation"
  data-webrev-id="presentation.do-it-your-way"
  data-config={JSON.stringify(runtimeConfig)}
  data-home-href={homeHref}
>
  <canvas id="prism-rail-canvas" aria-label="Do It Your Way spatial presentation"></canvas>
  <canvas id="glb-layer" aria-hidden="true"></canvas>
  <div class="sr-only" aria-live="polite" id="presentation-status"></div>
  <div id="edit-context-menu" class="edit-context-menu" hidden></div>

  <button
    type="button"
    id="sphere-settings-toggle"
    class="sphere-settings-toggle"
    aria-label="Sphere asset settings"
    aria-expanded="false"
    aria-controls="sphere-settings-panel"
  >⚙</button>

  <aside id="sphere-settings-panel" class="sphere-settings-panel" hidden>
    <div class="sphere-settings-header">
      <div>
        <strong id="station-settings-title">Sphere assets</strong>
        <div id="sphere-size-readout" class="sphere-size-readout"></div>
      </div>
      <button type="button" id="sphere-settings-close" class="sphere-settings-close" aria-label="Close settings">×</button>
    </div>

    <div id="api-settings-controls" class="api-settings-controls"></div>

    <label class="sphere-asset-add">
      <span>Add / restore asset</span>
      <select id="sphere-asset-picker">
        <option value="">Choose an asset…</option>
      </select>
    </label>

    <section class="sphere-side-section" aria-labelledby="front-assets-title">
      <div class="sphere-side-title" id="front-assets-title">Front</div>
      <div id="front-assets-list" class="sphere-asset-list"></div>
    </section>

    <section class="sphere-side-section" aria-labelledby="back-assets-title">
      <div class="sphere-side-title" id="back-assets-title">Back</div>
      <div id="back-assets-list" class="sphere-asset-list"></div>
    </section>
  </aside>
</div>

<script>
  import * as THREE from "../vendor/three.module.min.js";
  import { GLTFLoader } from "../vendor/GLTFLoader.js";
  import {
    cameraDistanceForPlacement,
    constrainBodyToHemisphereSphere,
    maxBodyRadiusForSphere,
    sphereFromCircumference,
    sphereFromDiameter,
    sphereFromRadius,
    type CameraPlacement
  } from "../lib/spatialSphere";
  import {
    fixedPositionAtTime,
    normalizeObjectMotion,
    type ObjectMotion
  } from "../lib/objectMotion";
  import {
    HEMISPHERE_CAMERA_PRESETS,
    hemisphereEditorCameraPosition,
    lookAnglesAt,
    screenBasis,
    type EditLayerState,
    type HemisphereCameraPreset
  } from "../lib/editLayer";

  type Vec3 = { x: number; y: number; z: number };
  type Projected = { x: number; y: number; depth: number; scale: number };
  type AssetAction =
    | { type: "station"; stationId: string }
    | { type: "link"; linkKey: string }
    | { type: "url"; url: string }
    | { type: "text"; title?: string; body?: string };

  type SceneObject = {
    id: string;
    name: string;
    kind: "2d" | "3d";
    url?: string;
    local: Vec3;
    velocity: Vec3;
    size: number;
    shape: number;
    spin: number;
    spinVelocity: number;
    phase: number;
    image?: HTMLImageElement;
    action?: AssetAction;
    depthLayer?: "near" | "middle" | "far";
    hideBehindImage?: boolean;
    hemisphere?: "front" | "back";
    visible?: boolean;
    modelBounds?: {
      min: Vec3;
      max: Vec3;
    };
    modelRadius?: number;
    motion: ObjectMotion;
    anchor: Vec3;
    anchorMode?: "absolute" | "camera-midpoint";
    anchorOffset?: Vec3;
    lastScreen?: { x: number; y: number; radius: number; depth: number };
  };

  type CameraMode = "locked" | "focus" | "free";
  type PresentationSettingKey =
    | "camera.mode"
    | "camera.placement"
    | "camera.distanceFromCenter"
    | "sphere.diameter"
    | "sphere.radius"
    | "sphere.circumference"
    | "sphere.restitution"
    | "viewport.enabled"
    | "viewport.paddingPx"
    | "debug.glbGlobe.enabled"
    | "debug.glbGlobe.objectName"
    | "editor.mode"
    | "editor.hemisphere"
    | "editor.cameraPreset"
    | "editor.repositionObjectName"
    | "textPlane.color"
    | "textPlane.width"
    | "textPlane.height"
    | "textPlane.offsetY"
    | "textPlane.offsetZ";
  type PresentationSettingValue = boolean | number | string;
  type AssetHemisphere = "front" | "back";
  type AssetPlacementState = Record<string, { hemisphere: AssetHemisphere; visible: boolean }>;
  type PresentationSettingsSnapshot = {
    camera: {
      mode: CameraMode;
      placement: CameraPlacement;
      distanceFromCenter: number;
    };
    sphere: {
      diameter: number;
      radius: number;
      circumference: number;
      restitution: number;
    };
    viewport: {
      enabled: boolean;
      paddingPx: number;
    };
    debug: {
      glbGlobe: {
        enabled: boolean;
        objectName: string;
      };
    };
    editor: EditLayerState;
    textPlane: { color: string; width: number; height: number; offsetY: number; offsetZ: number };
  };
  type GlbRuntimeStatus = "acknowledged" | "loading" | "loaded" | "retrying" | "failed";
  type SettingsListener = (settings: PresentationSettingsSnapshot) => void;
  type SettingOption = { value: string; label: string };
  type SettingDescriptor = {
    key: PresentationSettingKey;
    label: string;
    group: "sphere" | "camera" | "viewport" | "debug" | "editor" | "textPlane";
    control: "number" | "select" | "toggle" | "color";
    description?: string;
    min?: number;
    max?: number;
    step?: number;
    readOnly?: boolean;
    options?: SettingOption[];
  };

  declare global {
    interface Window {
      webrevPresentationSettings?: {
        get(key?: PresentationSettingKey): PresentationSettingsSnapshot | PresentationSettingValue;
        set(key: PresentationSettingKey, value: PresentationSettingValue): PresentationSettingsSnapshot;
        reset(key?: PresentationSettingKey): PresentationSettingsSnapshot;
        subscribe(listener: SettingsListener): () => void;
        describeSettings(stationId?: string): SettingDescriptor[];
        listAssets(stationId?: string): Array<{ name: string; hemisphere: AssetHemisphere; visible: boolean; motion: ObjectMotion; kind: "2d" | "3d"; uploaded: boolean; runtimeStatus?: GlbRuntimeStatus; loadAttempts?: number }>;
        setAssetHemisphere(name: string, hemisphere: AssetHemisphere): void;
        setAssetVisible(name: string, visible: boolean): void;
        getAssetMotion(name: string): ObjectMotion | null;
        setAssetMotion(name: string, motion: ObjectMotion): void;
        setGlbDebugGlobe(enabled: boolean, objectName?: string): void;
        getAssetRuntimeStatus(name: string): { status: GlbRuntimeStatus; attempts: number; lastError?: string } | null;
        getEditorState(): EditLayerState;
        setEditorMode(mode: "none" | "hemisphere", hemisphere?: AssetHemisphere): PresentationSettingsSnapshot;
        setEditorCameraPreset(preset: HemisphereCameraPreset): PresentationSettingsSnapshot;
        setRepositionObject(name: string | null): PresentationSettingsSnapshot;
        listEditorCameraPresets(): Array<{ id: HemisphereCameraPreset; label: string }>;
      };
    }
  }

  const root = document.querySelector<HTMLElement>(".presentation[data-config]");
  const canvas = document.getElementById("prism-rail-canvas");
  const glbCanvas = document.getElementById("glb-layer");
  const settingsToggle = document.getElementById("sphere-settings-toggle") as HTMLButtonElement | null;
  const settingsPanel = document.getElementById("sphere-settings-panel") as HTMLElement | null;
  const settingsClose = document.getElementById("sphere-settings-close") as HTMLButtonElement | null;
  const sphereSizeReadout = document.getElementById("sphere-size-readout");
  const stationSettingsTitle = document.getElementById("station-settings-title");
  const apiSettingsControls = document.getElementById("api-settings-controls");
  const assetPicker = document.getElementById("sphere-asset-picker") as HTMLSelectElement | null;
  const frontAssetsList = document.getElementById("front-assets-list");
  const backAssetsList = document.getElementById("back-assets-list");
  const editContextMenu = document.getElementById("edit-context-menu") as HTMLDivElement | null;

  let threeRenderer: any = null;
  let threeScene: any = null;
  let threeCamera: any = null;
  let gltfLoader: any = null;
  const threeObjects = new Map<string, any>();
  const threeLoading = new Set<string>();
  const threeLoadAttempts = new Map<string, number>();
  const threeRetryAt = new Map<string, number>();
  const glbRuntimeStatus = new Map<string, GlbRuntimeStatus>();
  const glbRuntimeError = new Map<string, string>();
  const occluders = new Map<number, any>();
  const debugGlobes = new Map<string, any>();
  const textPlanes = new Map<string, { mesh: any; texture: any; signature: string }>();

  function ensureThree() {
    if (threeRenderer || !(glbCanvas instanceof HTMLCanvasElement)) return;
    const T3: any = THREE;
    threeScene = new T3.Scene();
    threeCamera = new T3.PerspectiveCamera(50, 1, 0.05, 250);
    threeRenderer = new T3.WebGLRenderer({
      canvas: glbCanvas,
      alpha: true,
      antialias: true
    });
    threeRenderer.setClearColor(0x000000, 0);
    threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    threeScene.add(new T3.HemisphereLight(0xffffff, 0x30343b, 2.2));
    const key: any = new T3.DirectionalLight(0xffffff, 2.6);
    key.position.set(5, 8, 6);
    threeScene.add(key);
    gltfLoader = new (GLTFLoader as any)();
  }

  function publishGlbRuntimeStatus(obj: SceneObject, status: GlbRuntimeStatus, error?: unknown) {
    glbRuntimeStatus.set(obj.name, status);
    if (error != null) {
      const message = error instanceof Error ? error.message : String(error);
      glbRuntimeError.set(obj.name, message);
    } else if (status === "loaded" || status === "loading") {
      glbRuntimeError.delete(obj.name);
    }
    window.dispatchEvent(new CustomEvent("webrev:asset-runtime-status", {
      detail: {
        name: obj.name,
        status,
        attempts: threeLoadAttempts.get(obj.id) ?? 0,
        lastError: glbRuntimeError.get(obj.name)
      }
    }));
  }

  function ensureThreeObject(obj: SceneObject) {
    if (!obj.url || obj.kind !== "3d" || !gltfLoader || !threeScene || threeObjects.has(obj.id) || threeLoading.has(obj.id)) return;

    const now = performance.now();
    const retryAt = threeRetryAt.get(obj.id) ?? 0;
    if (now < retryAt) return;

    threeLoading.add(obj.id);
    publishGlbRuntimeStatus(obj, "loading");
    gltfLoader.load(
      obj.url,
      (gltf: any) => {
        const T3: any = THREE;
        const root: any = gltf.scene;
        const box: any = new T3.Box3().setFromObject(root);
        const center: any = box.getCenter(new T3.Vector3());
        const size: any = box.getSize(new T3.Vector3());
        const maxDimension = Math.max(size.x, size.y, size.z) || 1;
        root.position.sub(center);
        root.scale.setScalar(2 / maxDimension);

        // Recompute bounds after normalization. Viewport collision must use the
        // actual visible model extents rather than an estimated radius.
        root.updateMatrixWorld(true);
        const normalizedBox: any = new T3.Box3().setFromObject(root);
        obj.modelBounds = {
          min: {
            x: normalizedBox.min.x,
            y: normalizedBox.min.y,
            z: normalizedBox.min.z
          },
          max: {
            x: normalizedBox.max.x,
            y: normalizedBox.max.y,
            z: normalizedBox.max.z
          }
        };
        const normalizedSphere: any = normalizedBox.getBoundingSphere(new T3.Sphere());
        obj.modelRadius = normalizedSphere.radius;

        const group: any = new T3.Group();
        group.add(root);
        group.visible = false;
        threeScene.add(group);
        threeObjects.set(obj.id, group);
        threeLoading.delete(obj.id);
        threeLoadAttempts.delete(obj.id);
        threeRetryAt.delete(obj.id);
        publishGlbRuntimeStatus(obj, "loaded");
      },
      undefined,
      (error: any) => {
        threeLoading.delete(obj.id);
        const attempt = (threeLoadAttempts.get(obj.id) ?? 0) + 1;
        threeLoadAttempts.set(obj.id, attempt);
        const retryDelay = Math.min(8000, 400 * Math.pow(2, Math.min(attempt - 1, 4)));
        threeRetryAt.set(obj.id, performance.now() + retryDelay);
        publishGlbRuntimeStatus(obj, attempt >= 5 ? "failed" : "retrying", error);
        console.warn(`GLB load attempt ${attempt} failed for ${obj.name}; retrying in ${retryDelay}ms`, error);
      }
    );
  }

  function ensureImageOccluder(stationIndex: number, center: Vec3) {
    if (!threeScene) return null;
    const T3: any = THREE;
    let mesh: any = occluders.get(stationIndex);
    if (!mesh) {
      const geometry: any = new T3.PlaneGeometry(5.4, 5.9);
      const material: any = new T3.MeshBasicMaterial({
        colorWrite: false,
        depthWrite: true,
        depthTest: true,
        side: T3.DoubleSide
      });
      mesh = new T3.Mesh(geometry, material);
      mesh.renderOrder = -1000;
      threeScene.add(mesh);
      occluders.set(stationIndex, mesh);
    }
    mesh.position.set(center.x, center.y, center.z + 0.02);
    mesh.rotation.set(0, 0, 0);
    mesh.visible = true;
    return mesh;
  }


  function ensureDebugGlobe(obj: SceneObject) {
    if (!threeScene) return null;
    const T3: any = THREE;
    let globe: any = debugGlobes.get(obj.id);
    if (!globe) {
      const geometry: any = new T3.SphereGeometry(1, 24, 16);
      const material: any = new T3.MeshBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0.16,
        wireframe: true,
        depthTest: false
      });
      globe = new T3.Mesh(geometry, material);
      globe.renderOrder = 10000;
      globe.visible = false;
      threeScene.add(globe);
      debugGlobes.set(obj.id, globe);
    }
    return globe;
  }

  if (root && canvas instanceof HTMLCanvasElement) {
    const gameCanvas: HTMLCanvasElement = canvas;
    const config = JSON.parse(root.dataset.config ?? "{}");
    const settingsStorageKey = "webrev:spatial-settings:v3";
    const legacySettingsStorageKey = "webrev:spatial-settings:v2";
    const assetPlacementStorageKey = "webrev:asset-placement:v2";
    const assetMotionStorageKey = "webrev:asset-motion:v1";
    const stationDefinitions = Array.isArray(config.stations) ? config.stations : [];
    for (const station of stationDefinitions) {
      const assets = Array.isArray(config.assetsByArtwork?.[station.artworkName])
        ? config.assetsByArtwork[station.artworkName]
        : [];
      for (const asset of assets) {
        if (asset.kind === "3d" && !glbRuntimeStatus.has(asset.name)) {
          glbRuntimeStatus.set(asset.name, "acknowledged");
        }
      }
    }

    function allSceneAssetNames() {
      const result: Array<{ name: string; stationId: string; kind: "2d" | "3d"; uploaded: boolean }> = [];
      for (const station of stationDefinitions) {
        const assets = Array.isArray(config.assetsByArtwork?.[station.artworkName])
          ? config.assetsByArtwork[station.artworkName]
          : [];
        for (const asset of assets) result.push({
          name: asset.name,
          stationId: station.id,
          kind: asset.kind === "2d" ? "2d" : "3d",
          uploaded: true
        });

        const requestedDisplayMode = station.assetDisplayMode ?? config.arrangement?.assetDisplayMode;
        const displayMode = requestedDisplayMode === "assets-and-proxies"
          ? "assets-and-proxies"
          : "assets-only";
        const proxyCount = Math.max(
          0,
          Math.floor(Number(config.arrangement?.proxyCount ?? config.arrangement?.sphere?.defaultObjectCount ?? 10))
        );
        const fallbackProxyCount = assets.length === 0
          ? (proxyCount || Number(config.arrangement?.sphere?.defaultObjectCount) || 10)
          : 0;
        const extraProxyCount = displayMode === "assets-and-proxies" ? proxyCount : fallbackProxyCount;
        for (let i = 0; i < extraProxyCount; i++) {
          result.push({
            name: `${station.artworkName}-proxy-${i + 1}`,
            stationId: station.id,
            kind: "3d",
            uploaded: false
          });
        }
      }
      return result;
    }

    function configuredMotionFor(name: string) {
      return normalizeObjectMotion(config.assetMotion?.[name]);
    }

    function loadAssetMotionState() {
      let stored: Record<string, unknown> = {};
      try {
        stored = JSON.parse(window.localStorage.getItem(assetMotionStorageKey) ?? "{}");
      } catch {}

      const state: Record<string, ObjectMotion> = {};
      for (const asset of allSceneAssetNames()) {
        state[asset.name] = normalizeObjectMotion(
          stored?.[asset.name] ?? config.assetMotion?.[asset.name]
        );
      }
      return state;
    }

    let assetMotionState = loadAssetMotionState();

    function saveAssetMotionState() {
      try {
        window.localStorage.setItem(assetMotionStorageKey, JSON.stringify(assetMotionState));
      } catch {}
      window.dispatchEvent(new CustomEvent("webrev:asset-motion", { detail: assetMotionState }));
    }

    function loadAssetPlacement(): AssetPlacementState {
      let stored: any = {};
      try {
        stored = JSON.parse(window.localStorage.getItem(assetPlacementStorageKey) ?? "{}");
      } catch {}
      const state: AssetPlacementState = {};
      for (const asset of allSceneAssetNames()) {
        const saved = stored?.[asset.name];
        state[asset.name] = {
          hemisphere: saved?.hemisphere === "back" ? "back" : "front",
          visible: typeof saved?.visible === "boolean" ? saved.visible : true
        };
      }
      return state;
    }

    let assetPlacement = loadAssetPlacement();

    function saveAssetPlacement() {
      try {
        window.localStorage.setItem(assetPlacementStorageKey, JSON.stringify(assetPlacement));
      } catch {}
      window.dispatchEvent(new CustomEvent("webrev:asset-placement", { detail: assetPlacement }));
    }

    function defaultsForStation(station: any): PresentationSettingsSnapshot {
      const configuredDiameter = Number(
        station?.sphere?.diameter ??
        config.arrangement?.sphere?.diameter ??
        12.8
      );
      const configuredSphere = sphereFromDiameter(configuredDiameter);
      const placement: CameraPlacement =
        (station?.camera?.placement ?? config.arrangement?.camera?.placement) === "inside"
          ? "inside"
          : "outside";
      const requestedCameraDistance = Number(
        station?.camera?.distanceFromCenter ??
        config.arrangement?.camera?.distanceFromCenter
      );
      return {
        camera: {
          mode:
            station?.camera?.mode === "focus" || station?.camera?.mode === "free"
              ? station.camera.mode
              : config.arrangement?.camera?.mode === "focus" || config.arrangement?.camera?.mode === "free"
                ? config.arrangement.camera.mode
                : "locked",
          placement,
          distanceFromCenter: cameraDistanceForPlacement(
            placement,
            configuredSphere.radius,
            requestedCameraDistance
          )
        },
        sphere: {
          ...configuredSphere,
          restitution: Math.max(
            0,
            Math.min(
              1,
              Number(
                station?.sphere?.collision?.restitution ??
                config.arrangement?.sphere?.collision?.restitution ??
                config.arrangement?.motion?.boundaryRestitution ??
                0.5
              )
            )
          )
        },
        viewport: {
          enabled:
            typeof station?.viewport?.enabled === "boolean"
              ? station.viewport.enabled
              : typeof config.arrangement?.viewport?.enabled === "boolean"
                ? config.arrangement.viewport.enabled
                : true,
          paddingPx: Math.max(
            0,
            Number(station?.viewport?.paddingPx ?? config.arrangement?.viewport?.paddingPx ?? 18)
          )
        },
        debug: {
          glbGlobe: {
            enabled: Boolean(station?.debug?.glbGlobe?.enabled ?? config.arrangement?.debug?.glbGlobe?.enabled ?? false),
            objectName: String(station?.debug?.glbGlobe?.objectName ?? config.arrangement?.debug?.glbGlobe?.objectName ?? "")
          }
        },
        editor: { mode: "none" },
        textPlane: {
          color: String(station?.textPlane?.color ?? config.arrangement?.textPlane?.color ?? "#ffffff"),
          width: Math.max(0.2, Number(station?.textPlane?.width ?? config.arrangement?.textPlane?.width ?? 5.0)),
          height: Math.max(0.15, Number(station?.textPlane?.height ?? config.arrangement?.textPlane?.height ?? 0.75)),
          offsetY: Number(station?.textPlane?.offsetY ?? config.arrangement?.textPlane?.offsetY ?? -2.82),
          offsetZ: Number(station?.textPlane?.offsetZ ?? config.arrangement?.textPlane?.offsetZ ?? 0.72)
        }
      };
    }

    const settingsListeners = new Set<SettingsListener>();

    function cloneSettings(source: PresentationSettingsSnapshot): PresentationSettingsSnapshot {
      return {
        camera: {
          mode: source.camera.mode,
          placement: source.camera.placement,
          distanceFromCenter: Number(source.camera.distanceFromCenter)
        },
        sphere: {
          diameter: Number(source.sphere.diameter),
          radius: Number(source.sphere.radius),
          circumference: Number(source.sphere.circumference),
          restitution: Number(source.sphere.restitution)
        },
        viewport: {
          enabled: Boolean(source.viewport.enabled),
          paddingPx: Number(source.viewport.paddingPx)
        },
        debug: {
          glbGlobe: {
            enabled: Boolean(source.debug.glbGlobe.enabled),
            objectName: String(source.debug.glbGlobe.objectName ?? "")
          }
        },
        editor: source.editor.mode === "hemisphere"
          ? {
              mode: "hemisphere",
              hemisphere: source.editor.hemisphere,
              cameraPreset: source.editor.cameraPreset,
              repositionObjectName: source.editor.repositionObjectName
            }
          : { mode: "none" },
        textPlane: {
          color: String(source.textPlane.color),
          width: Number(source.textPlane.width),
          height: Number(source.textPlane.height),
          offsetY: Number(source.textPlane.offsetY),
          offsetZ: Number(source.textPlane.offsetZ)
        }
      };
    }

    function normalizeCameraForSphere(settings: PresentationSettingsSnapshot) {
      settings.camera.distanceFromCenter = cameraDistanceForPlacement(
        settings.camera.placement,
        settings.sphere.radius,
        settings.camera.distanceFromCenter
      );
    }

    function parseStoredSettings(raw: any, station: any): PresentationSettingsSnapshot {
      const defaults = defaultsForStation(station);
      const sphere = Number.isFinite(Number(raw?.sphere?.diameter))
        ? sphereFromDiameter(Number(raw.sphere.diameter))
        : defaults.sphere;
      const placement: CameraPlacement = raw?.camera?.placement === "inside"
        ? "inside"
        : raw?.camera?.placement === "outside"
          ? "outside"
          : defaults.camera.placement;
      const loaded: PresentationSettingsSnapshot = {
        camera: {
          mode:
            raw?.camera?.mode === "focus" || raw?.camera?.mode === "free"
              ? raw.camera.mode
              : defaults.camera.mode,
          placement,
          distanceFromCenter: cameraDistanceForPlacement(
            placement,
            sphere.radius,
            Number(raw?.camera?.distanceFromCenter)
          )
        },
        sphere: {
          ...sphere,
          restitution: Number.isFinite(Number(raw?.sphere?.restitution))
            ? Math.max(0, Math.min(1, Number(raw.sphere.restitution)))
            : defaults.sphere.restitution
        },
        viewport: {
          enabled:
            typeof raw?.viewport?.enabled === "boolean"
              ? raw.viewport.enabled
              : defaults.viewport.enabled,
          paddingPx: Number.isFinite(Number(raw?.viewport?.paddingPx))
            ? Math.max(0, Number(raw.viewport.paddingPx))
            : defaults.viewport.paddingPx
        },
        debug: {
          glbGlobe: {
            enabled:
              typeof raw?.debug?.glbGlobe?.enabled === "boolean"
                ? raw.debug.glbGlobe.enabled
                : defaults.debug.glbGlobe.enabled,
            objectName:
              typeof raw?.debug?.glbGlobe?.objectName === "string"
                ? raw.debug.glbGlobe.objectName
                : defaults.debug.glbGlobe.objectName
          }
        },
        editor: raw?.editor?.mode === "hemisphere"
          ? {
              mode: "hemisphere",
              hemisphere: raw?.editor?.hemisphere === "back" ? "back" : "front",
              cameraPreset:
                raw?.editor?.cameraPreset === "side" ||
                raw?.editor?.cameraPreset === "bottom-corner-up" ||
                raw?.editor?.cameraPreset === "top-left-down"
                  ? raw.editor.cameraPreset
                  : "top",
              repositionObjectName:
                typeof raw?.editor?.repositionObjectName === "string"
                  ? raw.editor.repositionObjectName
                  : ""
            }
          : { mode: "none" },
        textPlane: {
          color: typeof raw?.textPlane?.color === "string" ? raw.textPlane.color : defaults.textPlane.color,
          width: Number.isFinite(Number(raw?.textPlane?.width)) ? Math.max(0.2, Number(raw.textPlane.width)) : defaults.textPlane.width,
          height: Number.isFinite(Number(raw?.textPlane?.height)) ? Math.max(0.15, Number(raw.textPlane.height)) : defaults.textPlane.height,
          offsetY: Number.isFinite(Number(raw?.textPlane?.offsetY)) ? Number(raw.textPlane.offsetY) : defaults.textPlane.offsetY,
          offsetZ: Number.isFinite(Number(raw?.textPlane?.offsetZ)) ? Number(raw.textPlane.offsetZ) : defaults.textPlane.offsetZ
        }
      };
      normalizeCameraForSphere(loaded);
      return loaded;
    }

    function loadStationSettings() {
      let stored: any = {};
      let legacy: any = {};
      try {
        stored = JSON.parse(window.localStorage.getItem(settingsStorageKey) ?? "{}");
      } catch {}
      try {
        legacy = JSON.parse(window.localStorage.getItem(legacySettingsStorageKey) ?? "{}");
      } catch {}

      const byStation: Record<string, PresentationSettingsSnapshot> = {};
      for (const station of stationDefinitions) {
        byStation[station.id] = parseStoredSettings(
          stored?.stations?.[station.id] ?? legacy,
          station
        );
      }
      return byStation;
    }

    let stationSettings = loadStationSettings();
    let activeStationId = stationDefinitions[0]?.id ?? "default";
    let presentationSettings =
      stationSettings[activeStationId] ??
      defaultsForStation(stationDefinitions[0] ?? { id: activeStationId });

    function saveStationSettings() {
      try {
        window.localStorage.setItem(
          settingsStorageKey,
          JSON.stringify({ stations: stationSettings })
        );
      } catch {}
    }

    function publishSettings() {
      stationSettings[activeStationId] = presentationSettings;
      saveStationSettings();
      const snapshot = cloneSettings(presentationSettings);
      for (const listener of settingsListeners) listener(snapshot);
      window.dispatchEvent(new CustomEvent("webrev:presentation-settings", {
        detail: { stationId: activeStationId, settings: snapshot }
      }));
      return snapshot;
    }

    function applySphereGeometry(next: ReturnType<typeof sphereFromDiameter>) {
      presentationSettings.sphere.diameter = next.diameter;
      presentationSettings.sphere.radius = next.radius;
      presentationSettings.sphere.circumference = next.circumference;
      normalizeCameraForSphere(presentationSettings);
    }

    function describeSettingsForStation(stationId = activeStationId): SettingDescriptor[] {
      const glbOptions: SettingOption[] = [
        { value: "", label: "Choose GLB…" },
        ...allSceneAssetNames()
          .filter((asset) => asset.stationId === stationId && asset.kind === "3d" && asset.uploaded)
          .map((asset) => ({
            value: asset.name,
            label: `${asset.name} — ${glbRuntimeStatus.get(asset.name) ?? "acknowledged"}`
          }))
      ];
      const selectedDebugName = presentationSettings.debug.glbGlobe.objectName;
      const selectedStatus = selectedDebugName
        ? (glbRuntimeStatus.get(selectedDebugName) ?? "acknowledged")
        : null;
      const selectedAttempts = selectedDebugName
        ? (threeLoadAttempts.get(
            Array.from(threeObjects.keys()).find((id) => id.includes(selectedDebugName)) ?? ""
          ) ?? 0)
        : 0;

      return [
        {
          key: "sphere.diameter",
          label: "Sphere diameter",
          group: "sphere",
          control: "number",
          description: "Image is the exact center of the sphere.",
          min: 0.2,
          step: 0.2
        },
        {
          key: "sphere.circumference",
          label: "Sphere circumference",
          group: "sphere",
          control: "number",
          min: 0.2,
          step: 0.2
        },
        {
          key: "sphere.radius",
          label: "Sphere radius",
          group: "sphere",
          control: "number",
          readOnly: true,
          step: 0.01
        },
        {
          key: "camera.placement",
          label: "Camera position",
          group: "camera",
          control: "select",
          options: [
            { value: "outside", label: "Outside sphere" },
            { value: "inside", label: "Inside sphere" }
          ]
        },
        {
          key: "viewport.enabled",
          label: "Keep assets in viewport",
          group: "viewport",
          control: "toggle",
          description: "Second rule: visible geometry cannot leave the screen."
        },
        {
          key: "debug.glbGlobe.enabled",
          label: "Debug globe",
          group: "debug",
          control: "toggle",
          description: selectedStatus
            ? `Selected GLB status: ${selectedStatus}`
            : "Draw a transparent sphere where the engine believes the selected GLB exists."
        },
        {
          key: "debug.glbGlobe.objectName",
          label: "Debug GLB object",
          group: "debug",
          control: "select",
          description: selectedStatus
            ? `Runtime: ${selectedStatus}${selectedAttempts ? ` · attempts ${selectedAttempts}` : ""}`
            : "Pick a GLB to inspect.",
          options: glbOptions
        },
        {
          key: "editor.mode",
          label: "Edit Layer mode",
          group: "editor",
          control: "select",
          description: "Editor modules define their own camera and interaction rules.",
          options: [
            { value: "none", label: "Off" },
            { value: "hemisphere", label: "Hemisphere Editor" }
          ]
        },
        {
          key: "editor.hemisphere",
          label: "Hemisphere",
          group: "editor",
          control: "select",
          options: [
            { value: "front", label: "Front" },
            { value: "back", label: "Back" }
          ]
        },
        {
          key: "editor.cameraPreset",
          label: "Hemisphere camera",
          group: "editor",
          control: "select",
          description: "Hemisphere Editor only: image stays visible and the active half stays spatially useful.",
          options: HEMISPHERE_CAMERA_PRESETS.map((preset) => ({ value: preset.id, label: preset.label }))
        },
        { key: "textPlane.color", label: "Text plane color", group: "textPlane", control: "color", description: "Separate horizontal world-space plaque at the image's feet." },
        { key: "textPlane.width", label: "Text plane width", group: "textPlane", control: "number", min: 0.2, step: 0.1 },
        { key: "textPlane.height", label: "Text plane depth", group: "textPlane", control: "number", min: 0.15, step: 0.05 },
        { key: "textPlane.offsetY", label: "Text plane height offset", group: "textPlane", control: "number", step: 0.05 },
        { key: "textPlane.offsetZ", label: "Text plane forward offset", group: "textPlane", control: "number", step: 0.05 }
      ];
    }

    window.webrevPresentationSettings = {
      get(key?: PresentationSettingKey) {
        if (key === "camera.mode") return presentationSettings.camera.mode;
        if (key === "camera.placement") return presentationSettings.camera.placement;
        if (key === "camera.distanceFromCenter") return presentationSettings.camera.distanceFromCenter;
        if (key === "sphere.diameter") return presentationSettings.sphere.diameter;
        if (key === "sphere.radius") return presentationSettings.sphere.radius;
        if (key === "sphere.circumference") return presentationSettings.sphere.circumference;
        if (key === "sphere.restitution") return presentationSettings.sphere.restitution;
        if (key === "viewport.enabled") return presentationSettings.viewport.enabled;
        if (key === "viewport.paddingPx") return presentationSettings.viewport.paddingPx;
        if (key === "debug.glbGlobe.enabled") return presentationSettings.debug.glbGlobe.enabled;
        if (key === "debug.glbGlobe.objectName") return presentationSettings.debug.glbGlobe.objectName;
        if (key === "editor.mode") return presentationSettings.editor.mode;
        if (key === "editor.hemisphere") return presentationSettings.editor.mode === "hemisphere" ? presentationSettings.editor.hemisphere : "front";
        if (key === "editor.cameraPreset") return presentationSettings.editor.mode === "hemisphere" ? presentationSettings.editor.cameraPreset : "top";
        if (key === "editor.repositionObjectName") return presentationSettings.editor.mode === "hemisphere" ? presentationSettings.editor.repositionObjectName : "";
        if (key === "textPlane.color") return presentationSettings.textPlane.color;
        if (key === "textPlane.width") return presentationSettings.textPlane.width;
        if (key === "textPlane.height") return presentationSettings.textPlane.height;
        if (key === "textPlane.offsetY") return presentationSettings.textPlane.offsetY;
        if (key === "textPlane.offsetZ") return presentationSettings.textPlane.offsetZ;
        return cloneSettings(presentationSettings);
      },
      set(key: PresentationSettingKey, value: PresentationSettingValue) {
        if (key === "camera.mode") {
          presentationSettings.camera.mode =
            value === "focus" || value === "free" ? value : "locked";
        } else if (key === "camera.placement") {
          presentationSettings.camera.placement = value === "inside" ? "inside" : "outside";
          presentationSettings.camera.distanceFromCenter = cameraDistanceForPlacement(
            presentationSettings.camera.placement,
            presentationSettings.sphere.radius
          );
        } else if (key === "camera.distanceFromCenter") {
          presentationSettings.camera.distanceFromCenter = cameraDistanceForPlacement(
            presentationSettings.camera.placement,
            presentationSettings.sphere.radius,
            Number(value)
          );
        } else if (key === "sphere.diameter") {
          applySphereGeometry(sphereFromDiameter(Number(value)));
        } else if (key === "sphere.radius") {
          applySphereGeometry(sphereFromRadius(Number(value)));
        } else if (key === "sphere.circumference") {
          applySphereGeometry(sphereFromCircumference(Number(value)));
        } else if (key === "sphere.restitution") {
          presentationSettings.sphere.restitution = Math.max(0, Math.min(1, Number(value) || 0));
        } else if (key === "viewport.enabled") {
          presentationSettings.viewport.enabled = Boolean(value);
        } else if (key === "viewport.paddingPx") {
          presentationSettings.viewport.paddingPx = Math.max(0, Number(value) || 0);
        } else if (key === "debug.glbGlobe.enabled") {
          presentationSettings.debug.glbGlobe.enabled = Boolean(value);
        } else if (key === "debug.glbGlobe.objectName") {
          presentationSettings.debug.glbGlobe.objectName = String(value ?? "");
        } else if (key === "editor.mode") {
          presentationSettings.editor = value === "hemisphere"
            ? { mode: "hemisphere", hemisphere: "front", cameraPreset: "top", repositionObjectName: "" }
            : { mode: "none" };
        } else if (key === "editor.hemisphere") {
          if (presentationSettings.editor.mode === "hemisphere") {
            presentationSettings.editor.hemisphere = value === "back" ? "back" : "front";
          }
        } else if (key === "editor.cameraPreset") {
          if (presentationSettings.editor.mode === "hemisphere") {
            presentationSettings.editor.cameraPreset =
              value === "side" || value === "bottom-corner-up" || value === "top-left-down"
                ? value
                : "top";
          }
        } else if (key === "editor.repositionObjectName") {
          if (presentationSettings.editor.mode === "hemisphere") presentationSettings.editor.repositionObjectName = String(value ?? "");
        } else if (key === "textPlane.color") {
          presentationSettings.textPlane.color = String(value || "#ffffff");
        } else if (key === "textPlane.width") {
          presentationSettings.textPlane.width = Math.max(0.2, Number(value) || 0.2);
        } else if (key === "textPlane.height") {
          presentationSettings.textPlane.height = Math.max(0.15, Number(value) || 0.15);
        } else if (key === "textPlane.offsetY") {
          presentationSettings.textPlane.offsetY = Number(value) || 0;
        } else if (key === "textPlane.offsetZ") {
          presentationSettings.textPlane.offsetZ = Number(value) || 0;
        }
        return publishSettings();
      },
      reset(key?: PresentationSettingKey) {
        const defaults = defaultsForStation(
          stationDefinitions.find((station: any) => station.id === activeStationId)
        );
        if (!key) {
          presentationSettings = cloneSettings(defaults);
          stationSettings[activeStationId] = presentationSettings;
          return publishSettings();
        }
        if (key === "camera.mode") presentationSettings.camera.mode = defaults.camera.mode;
        if (key === "camera.placement") {
          presentationSettings.camera.placement = defaults.camera.placement;
          presentationSettings.camera.distanceFromCenter = defaults.camera.distanceFromCenter;
        }
        if (key === "camera.distanceFromCenter") {
          presentationSettings.camera.distanceFromCenter = defaults.camera.distanceFromCenter;
        }
        if (key === "sphere.diameter" || key === "sphere.radius" || key === "sphere.circumference") {
          applySphereGeometry(sphereFromDiameter(defaults.sphere.diameter));
        }
        if (key === "sphere.restitution") presentationSettings.sphere.restitution = defaults.sphere.restitution;
        if (key === "viewport.enabled") presentationSettings.viewport.enabled = defaults.viewport.enabled;
        if (key === "viewport.paddingPx") presentationSettings.viewport.paddingPx = defaults.viewport.paddingPx;
        if (key === "debug.glbGlobe.enabled") presentationSettings.debug.glbGlobe.enabled = defaults.debug.glbGlobe.enabled;
        if (key === "debug.glbGlobe.objectName") presentationSettings.debug.glbGlobe.objectName = defaults.debug.glbGlobe.objectName;
        if (key === "editor.mode" || key === "editor.hemisphere" || key === "editor.cameraPreset" || key === "editor.repositionObjectName") presentationSettings.editor = { mode: "none" };
        if (key === "textPlane.color") presentationSettings.textPlane.color = defaults.textPlane.color;
        if (key === "textPlane.width") presentationSettings.textPlane.width = defaults.textPlane.width;
        if (key === "textPlane.height") presentationSettings.textPlane.height = defaults.textPlane.height;
        if (key === "textPlane.offsetY") presentationSettings.textPlane.offsetY = defaults.textPlane.offsetY;
        if (key === "textPlane.offsetZ") presentationSettings.textPlane.offsetZ = defaults.textPlane.offsetZ;
        normalizeCameraForSphere(presentationSettings);
        return publishSettings();
      },
      subscribe(listener: SettingsListener) {
        settingsListeners.add(listener);
        listener(cloneSettings(presentationSettings));
        return () => settingsListeners.delete(listener);
      },
      describeSettings(stationId?: string) {
        return describeSettingsForStation(stationId ?? activeStationId);
      },
      listAssets(stationId?: string) {
        const targetStationId = stationId ?? activeStationId;
        const inventory = allSceneAssetNames()
          .filter((asset) => asset.stationId === targetStationId);
        return inventory.map((asset) => {
          const state = assetPlacement[asset.name] ?? {
            hemisphere: "front" as AssetHemisphere,
            visible: true
          };
          return {
            name: asset.name,
            ...state,
            motion: assetMotionState[asset.name] ?? configuredMotionFor(asset.name),
            kind: asset.kind,
            uploaded: asset.uploaded,
            runtimeStatus: asset.kind === "3d" && asset.uploaded
              ? (glbRuntimeStatus.get(asset.name) ?? "acknowledged")
              : undefined,
            loadAttempts: asset.kind === "3d" && asset.uploaded
              ? Array.from(threeLoadAttempts.entries())
                  .filter(([id]) => id.includes(asset.name))
                  .reduce((max, [, attempts]) => Math.max(max, attempts), 0)
              : undefined
          };
        });
      },
      setAssetHemisphere(name: string, hemisphere: AssetHemisphere) {
        assetPlacement[name] ??= { hemisphere: "front", visible: true };
        assetPlacement[name].hemisphere = hemisphere === "back" ? "back" : "front";
        assetPlacement[name].visible = true;
        saveAssetPlacement();
      },
      setAssetVisible(name: string, visible: boolean) {
        assetPlacement[name] ??= { hemisphere: "front", visible: true };
        assetPlacement[name].visible = Boolean(visible);
        saveAssetPlacement();
      },
      getAssetMotion(name: string) {
        if (!allSceneAssetNames().some((asset) => asset.name === name)) return null;
        return normalizeObjectMotion(assetMotionState[name] ?? configuredMotionFor(name));
      },
      setAssetMotion(name: string, motion: ObjectMotion) {
        if (!allSceneAssetNames().some((asset) => asset.name === name)) return;
        assetMotionState[name] = normalizeObjectMotion(motion);
        saveAssetMotionState();
      },
      setGlbDebugGlobe(enabled: boolean, objectName?: string) {
        presentationSettings.debug.glbGlobe.enabled = Boolean(enabled);
        if (typeof objectName === "string") {
          presentationSettings.debug.glbGlobe.objectName = objectName;
        }
        publishSettings();
      },
      getAssetRuntimeStatus(name: string) {
        const known = allSceneAssetNames().some(
          (asset) => asset.name === name && asset.kind === "3d" && asset.uploaded
        );
        if (!known) return null;
        return {
          status: glbRuntimeStatus.get(name) ?? "acknowledged",
          attempts: Array.from(threeLoadAttempts.entries())
            .filter(([id]) => id.includes(name))
            .reduce((max, [, attempts]) => Math.max(max, attempts), 0),
          lastError: glbRuntimeError.get(name)
        };
      },
      getEditorState() {
        return presentationSettings.editor.mode === "hemisphere"
          ? { ...presentationSettings.editor }
          : { mode: "none" };
      },
      setEditorMode(mode: "none" | "hemisphere", hemisphere?: AssetHemisphere) {
        presentationSettings.editor = mode === "hemisphere"
          ? {
              mode: "hemisphere",
              hemisphere: hemisphere === "back" ? "back" : "front",
              cameraPreset: "top",
              repositionObjectName: ""
            }
          : { mode: "none" };
        return publishSettings();
      },
      setEditorCameraPreset(preset: HemisphereCameraPreset) {
        if (presentationSettings.editor.mode === "hemisphere") {
          presentationSettings.editor.cameraPreset =
            preset === "side" || preset === "bottom-corner-up" || preset === "top-left-down"
              ? preset
              : "top";
        }
        return publishSettings();
      },
      setRepositionObject(name: string | null) {
        if (presentationSettings.editor.mode === "hemisphere") {
          presentationSettings.editor.repositionObjectName = name ?? "";
          if (name) {
            const asset = assetPlacement[name];
            if (asset) presentationSettings.editor.hemisphere = asset.hemisphere;
          }
        }
        return publishSettings();
      },
      listEditorCameraPresets() {
        return HEMISPHERE_CAMERA_PRESETS.map((preset) => ({ ...preset }));
      }
    };

    const stations = stationDefinitions;
    const assetsByArtwork = config.assetsByArtwork ?? {};
    const assetActions = config.assetActions ?? {};
    const resolvedLinks = config.resolvedLinks ?? {};
    const ctxMaybe = gameCanvas.getContext("2d");

    if (ctxMaybe && stations.length) {
      const ctx: CanvasRenderingContext2D = ctxMaybe;
      const status = document.getElementById("presentation-status");
      const rail = config.rail;
      const arrangement = config.arrangement;
      const billboard = arrangement.billboard2d ?? {};
      const motion = arrangement.motion ?? {};
      const sphere = arrangement.sphere ?? arrangement.influenceSphere ?? { defaultObjectCount: 12 };
      const exclusion = arrangement.viewportExclusion;
      const spacing = Number(rail.stationSpacing) || 26;
      const rideSpeed = Number(rail.speed) || 7.5;
      const prismRadius = Number(rail.prismRadius) || 3.4;

      function sphereRadius() {
        return presentationSettings.sphere.radius;
      }

      function objectBodyRadius(obj: SceneObject) {
        if (obj.kind === "3d" && Number.isFinite(obj.modelRadius)) {
          return Math.max(0.02, Number(obj.modelRadius) * obj.size);
        }
        return Math.max(0.02, obj.size);
      }


      let width = 1;
      let height = 1;
      let cameraZ = 9;
      let targetZ = stationZ(0) + presentationSettings.camera.distanceFromCenter;
      let arrivingAt = 0;
      let lookYaw = 0;
      let lookPitch = 0;
      let targetYaw = 0;
      let targetPitch = 0;
      let pointerX = 0;
      let pointerY = 0;
      let previous = performance.now();

      let paperTextOverride: { title?: string; body?: string } | null = null;
      let grabbed: { stationIndex: number; object: SceneObject } | null = null;
      let dragLastX = 0;
      let dragLastY = 0;
      let dragLastTime = performance.now();
      let draggedDistance = 0;

      const layouts = stations.map((station: any, index: number) => generateLayout(station, index));
      ensureThree();
      for (const layout of layouts) {
        for (const obj of layout) ensureThreeObject(obj);
      }

      function makeAssetRow(obj: SceneObject) {
        const row = document.createElement("div");
        row.className = "sphere-asset-row";

        const name = document.createElement("span");
        name.className = "sphere-asset-name";
        name.textContent = obj.name;

        const side = document.createElement("select");
        side.className = "sphere-side-select";
        side.setAttribute("aria-label", `Placement for ${obj.name}`);
        for (const value of ["front", "back"] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = value === "front" ? "Front" : "Back";
          option.selected = obj.hemisphere === value;
          side.appendChild(option);
        }
        side.addEventListener("change", () => {
          window.webrevPresentationSettings?.setAssetHemisphere(
            obj.name,
            side.value === "back" ? "back" : "front"
          );
        });

        const motionSelect = document.createElement("select");
        motionSelect.className = "sphere-motion-select";
        motionSelect.setAttribute("aria-label", `Motion for ${obj.name}`);
        const motionOptions = [
          ["free", "Free"],
          ["fixed-anchored", "Fixed"],
          ["fixed-range", "Fixed range"]
        ] as const;
        const currentMotionValue =
          obj.motion.type === "free"
            ? "free"
            : obj.motion.fixedMode === "range"
              ? "fixed-range"
              : "fixed-anchored";
        for (const [value, label] of motionOptions) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          option.selected = value === currentMotionValue;
          motionSelect.appendChild(option);
        }
        motionSelect.addEventListener("change", () => {
          if (motionSelect.value === "free") {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, { type: "free" });
          } else if (motionSelect.value === "fixed-range") {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, {
              type: "fixed",
              fixedMode: "range",
              range: 0.8,
              behavior: { type: "bob", amplitude: 0.35, speed: 0.7 }
            });
          } else {
            window.webrevPresentationSettings?.setAssetMotion(obj.name, {
              type: "fixed",
              fixedMode: "anchored",
              behavior: { type: "none" }
            });
          }
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "sphere-asset-remove";
        remove.setAttribute("aria-label", `Hide ${obj.name}`);
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          window.webrevPresentationSettings?.setAssetVisible(obj.name, false);
        });

        row.append(name, side, motionSelect, remove);
        return row;
      }

      function currentApiValue(key: PresentationSettingKey) {
        return window.webrevPresentationSettings?.get(key);
      }

      function setApiValue(key: PresentationSettingKey, value: PresentationSettingValue) {
        window.webrevPresentationSettings?.set(key, value);
      }

      function renderApiSettingsControls() {
        if (!apiSettingsControls) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        apiSettingsControls.replaceChildren();
        const descriptors = api.describeSettings(activeStationId);
        let currentGroup = "";

        for (const descriptor of descriptors) {
          if (descriptor.group !== currentGroup) {
            currentGroup = descriptor.group;
            const heading = document.createElement("div");
            heading.className = "api-settings-group-title";
            heading.textContent =
              descriptor.group === "sphere" ? "Sphere geometry" :
              descriptor.group === "camera" ? "Camera" :
              descriptor.group === "viewport" ? "Viewport" :
              descriptor.group === "debug" ? "Debug" :
              descriptor.group === "editor" ? "Edit Layer" :
              "Text plane";
            apiSettingsControls.appendChild(heading);
          }

          const row = document.createElement("label");
          row.className = descriptor.control === "toggle"
            ? "api-setting-row api-setting-toggle"
            : "api-setting-row";

          const textWrap = document.createElement("span");
          textWrap.className = "api-setting-copy";
          const label = document.createElement("strong");
          label.textContent = descriptor.label;
          textWrap.appendChild(label);
          if (descriptor.description) {
            const description = document.createElement("small");
            description.textContent = descriptor.description;
            textWrap.appendChild(description);
          }

          const current = currentApiValue(descriptor.key);

          if (descriptor.control === "toggle") {
            const input = document.createElement("input");
            input.type = "checkbox";
            input.checked = Boolean(current);
            input.addEventListener("change", () => setApiValue(descriptor.key, input.checked));
            row.append(input, textWrap);
          } else if (descriptor.control === "select") {
            const select = document.createElement("select");
            select.className = "api-setting-control";
            for (const choice of descriptor.options ?? []) {
              const option = document.createElement("option");
              option.value = choice.value;
              option.textContent = choice.label;
              option.selected = String(current ?? "") === choice.value;
              select.appendChild(option);
            }
            select.disabled = Boolean(descriptor.readOnly);
            select.addEventListener("change", () => setApiValue(descriptor.key, select.value));
            row.append(textWrap, select);
          } else if (descriptor.control === "color") {
            const input = document.createElement("input");
            input.className = "api-setting-control";
            input.type = "color";
            input.value = typeof current === "string" && /^#[0-9a-f]{6}$/i.test(current) ? current : "#ffffff";
            input.addEventListener("input", () => setApiValue(descriptor.key, input.value));
            row.append(textWrap, input);
          } else {
            const input = document.createElement("input");
            input.className = "api-setting-control";
            input.type = "number";
            if (descriptor.min != null) input.min = String(descriptor.min);
            if (descriptor.max != null) input.max = String(descriptor.max);
            if (descriptor.step != null) input.step = String(descriptor.step);
            input.readOnly = Boolean(descriptor.readOnly);
            input.value = Number(current ?? 0).toFixed(descriptor.step && descriptor.step < 0.1 ? 2 : 1);
            const commit = () => {
              if (descriptor.readOnly) return;
              const value = Number(input.value);
              if (Number.isFinite(value)) setApiValue(descriptor.key, value);
            };
            input.addEventListener("change", commit);
            input.addEventListener("keydown", (event) => {
              if (event.key !== "Enter") return;
              event.preventDefault();
              commit();
            });
            row.append(textWrap, input);
          }

          apiSettingsControls.appendChild(row);
        }
      }

      function makeAssetRowFromApi(asset: ReturnType<NonNullable<typeof window.webrevPresentationSettings>["listAssets"]>[number]) {
        const row = document.createElement("div");
        row.className = "sphere-asset-row";

        const name = document.createElement("span");
        name.className = "sphere-asset-name";
        name.textContent = asset.name;

        const side = document.createElement("select");
        side.className = "sphere-side-select";
        side.setAttribute("aria-label", `Placement for ${asset.name}`);
        for (const value of ["front", "back"] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = value === "front" ? "Front" : "Back";
          option.selected = asset.hemisphere === value;
          side.appendChild(option);
        }
        side.addEventListener("change", () => {
          window.webrevPresentationSettings?.setAssetHemisphere(
            asset.name,
            side.value === "back" ? "back" : "front"
          );
        });

        const motionSelect = document.createElement("select");
        motionSelect.className = "sphere-motion-select";
        motionSelect.setAttribute("aria-label", `Motion for ${asset.name}`);
        const currentMotionValue =
          asset.motion.type === "free"
            ? "free"
            : asset.motion.fixedMode === "range"
              ? "fixed-range"
              : "fixed-anchored";
        for (const [value, label] of [
          ["free", "Free"],
          ["fixed-anchored", "Fixed"],
          ["fixed-range", "Fixed range"]
        ] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          option.selected = value === currentMotionValue;
          motionSelect.appendChild(option);
        }
        motionSelect.addEventListener("change", () => {
          if (motionSelect.value === "free") {
            window.webrevPresentationSettings?.setAssetMotion(asset.name, { type: "free" });
          } else if (motionSelect.value === "fixed-range") {
            window.webrevPresentationSettings?.setAssetMotion(asset.name, {
              type: "fixed",
              fixedMode: "range",
              range: 0.8,
              behavior: { type: "bob", amplitude: 0.35, speed: 0.7 }
            });
          } else {
            window.webrevPresentationSettings?.setAssetMotion(asset.name, {
              type: "fixed",
              fixedMode: "anchored",
              behavior: { type: "none" }
            });
          }
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "sphere-asset-remove";
        remove.setAttribute("aria-label", `Hide ${asset.name}`);
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          window.webrevPresentationSettings?.setAssetVisible(asset.name, false);
        });

        row.append(name, side, motionSelect, remove);
        return row;
      }

      function renderSphereSettings() {
        if (!frontAssetsList || !backAssetsList || !assetPicker || !sphereSizeReadout) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        const currentStation = stations[arrivingAt];
        if (stationSettingsTitle) {
          stationSettingsTitle.textContent = `${currentStation?.label ?? "Section"} settings`;
        }
        const snapshot = api.get() as PresentationSettingsSnapshot;
        sphereSizeReadout.textContent =
          `Radius ${snapshot.sphere.radius.toFixed(2)} · collision boundary = sphere surface`;

        renderApiSettingsControls();

        frontAssetsList.replaceChildren();
        backAssetsList.replaceChildren();

        const assets = api.listAssets(activeStationId);
        const hidden = assets.filter((asset) => asset.visible === false);

        for (const asset of assets.filter((asset) => asset.visible !== false && asset.hemisphere !== "back")) {
          frontAssetsList.appendChild(makeAssetRowFromApi(asset));
        }
        for (const asset of assets.filter((asset) => asset.visible !== false && asset.hemisphere === "back")) {
          backAssetsList.appendChild(makeAssetRowFromApi(asset));
        }

        assetPicker.replaceChildren();
        const prompt = document.createElement("option");
        prompt.value = "";
        prompt.textContent = hidden.length ? "Choose an asset…" : "All assets are displayed";
        assetPicker.appendChild(prompt);
        for (const asset of hidden) {
          const option = document.createElement("option");
          option.value = asset.name;
          option.textContent = asset.name;
          assetPicker.appendChild(option);
        }
        assetPicker.disabled = hidden.length === 0;
      }

      settingsToggle?.addEventListener("click", () => {
        if (!settingsPanel) return;
        const open = settingsPanel.hidden;
        settingsPanel.hidden = !open;
        settingsToggle.setAttribute("aria-expanded", String(open));
        if (open) renderSphereSettings();
      });
      settingsClose?.addEventListener("click", () => {
        if (!settingsPanel) return;
        settingsPanel.hidden = true;
        settingsToggle?.setAttribute("aria-expanded", "false");
      });
      assetPicker?.addEventListener("change", () => {
        const name = assetPicker.value;
        if (!name) return;
        window.webrevPresentationSettings?.setAssetHemisphere(name, "front");
        window.webrevPresentationSettings?.setAssetVisible(name, true);
        assetPicker.value = "";
      });
      window.addEventListener("webrev:presentation-settings", () => {
        stationSettings[activeStationId] = presentationSettings;
        targetZ = stationZ(arrivingAt) + presentationSettings.camera.distanceFromCenter;
        renderSphereSettings();
      });
      window.addEventListener("webrev:asset-placement", () => {
        syncAssetPlacementToLayouts();
        renderSphereSettings();
      });
      window.addEventListener("webrev:asset-runtime-status", () => {
        if (settingsPanel && !settingsPanel.hidden) renderSphereSettings();
      });
      window.addEventListener("webrev:asset-motion", () => {
        for (const layout of layouts) {
          for (const obj of layout) {
            obj.motion = normalizeObjectMotion(
              assetMotionState[obj.name] ?? config.assetMotion?.[obj.name]
            );
            if (obj.motion.type === "fixed") {
              obj.velocity = { x: 0, y: 0, z: 0 };
              obj.anchor = currentFixedAnchor(obj);
              obj.local = { ...obj.anchor };
            } else {
              obj.anchor = { ...obj.local };
            }
          }
        }
        renderSphereSettings();
      });
      renderSphereSettings();

      function stationZ(index: number) {
        return -18 - index * spacing;
      }

      function hashSeed(text: string, seed: number) {
        let h = seed | 0;
        for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
        return h >>> 0;
      }

      function rngFor(station: any, index: number) {
        const randomVisit = arrangement.mode === "random-every-visit";
        let state = randomVisit
          ? ((Math.random() * 0xffffffff) >>> 0)
          : hashSeed(station.artworkName ?? station.id ?? String(index), Number(arrangement.seed) || 1);

        return () => {
          state += 0x6D2B79F5;
          let t = state;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function insideProtectedViewport(p: Vec3) {
        const pad = Number(exclusion.padding) || 0;
        return (
          Math.abs(p.x) < Number(exclusion.width) * 0.5 + pad &&
          Math.abs(p.y) < Number(exclusion.height) * 0.5 + pad &&
          Math.abs(p.z) < Number(exclusion.depth) * 0.5 + pad
        );
      }

      function randomPlacement(rand: () => number): Vec3 {
        const outer = sphereRadius() * 0.72;
        const inner = sphereRadius() * 0.28;
        const radius = inner + (outer - inner) * Math.cbrt(rand());
        const theta = rand() * Math.PI * 2;
        const cosPhi = rand() * 2 - 1;
        const sinPhi = Math.sqrt(Math.max(0, 1 - cosPhi * cosPhi));
        return {
          x: Math.cos(theta) * sinPhi * radius,
          y: cosPhi * radius,
          z: Math.sin(theta) * sinPhi * radius
        };
      }

      function resolve3dSettings(station: any) {
        const defaults = arrangement.asset3d ?? {};
        const override = station.asset3d ?? {};
        const requestedLayer = override.layer ?? defaults.layer ?? "middle";
        const layer: "near" | "middle" | "far" =
          requestedLayer === "near" || requestedLayer === "far" ? requestedLayer : "middle";
        return {
          layer,
          hideBehindImage: Boolean(override.hideBehindImage ?? defaults.hideBehindImage ?? true)
        };
      }

      function applyDepthLayer(position: Vec3, layer: "near" | "middle" | "far"): Vec3 {
        // Camera sits in front of each station along +Z, so positive local Z is nearer.
        // Near assets must stay inside a tighter screen-visible envelope because
        // perspective magnifies their x/y offsets substantially.
        if (layer === "near") {
          position.x *= 0.5;
          position.y *= 0.5;
          position.z = Math.abs(position.z) * 0.24 + sphereRadius() * 0.30;
        } else if (layer === "far") {
          position.z = -Math.abs(position.z) * 0.45 - sphereRadius() * 0.34;
        } else {
          position.z *= 0.3;
        }
        return position;
      }

      function placeUploaded3d(
        assetIndex: number,
        assetCount: number,
        layer: "near" | "middle" | "far"
      ): Vec3 {
        const count = Math.max(1, assetCount);
        const angle = -Math.PI / 2 + (assetIndex / count) * Math.PI * 2;
        const ring = Math.max(2.4, Math.min(sphereRadius() * 0.58, 3.6));
        const position: Vec3 = {
          x: Math.cos(angle) * ring,
          y: Math.sin(angle) * ring * 0.72,
          z: 0
        };
        return applyDepthLayer(position, layer);
      }

      function enforceHemisphere(obj: SceneObject) {
        const minimum = Math.max(0.02, objectBodyRadius(obj));
        const magnitude = Math.max(Math.abs(obj.local.z), minimum);
        obj.local.z = obj.hemisphere === "back" ? -magnitude : magnitude;
      }

      function syncAssetPlacementToLayouts() {
        if (typeof layouts === "undefined") return;
        for (const layout of layouts) {
          for (const obj of layout) {
            const state = assetPlacement[obj.name] ?? { hemisphere: "front" as AssetHemisphere, visible: true };
            obj.hemisphere = state.hemisphere;
            obj.visible = state.visible;
            enforceHemisphere(obj);
          }
        }
      }

      function resolveConfiguredAnchor(
        name: string,
        fallback: Vec3
      ): {
        anchor: Vec3;
        mode: "absolute" | "camera-midpoint";
        offset: Vec3;
      } {
        const raw = config.assetMotion?.[name]?.anchor;
        const offset: Vec3 = {
          x: Number(raw?.offset?.x) || 0,
          y: Number(raw?.offset?.y) || 0,
          z: Number(raw?.offset?.z) || 0
        };

        if (raw?.mode === "camera-midpoint") {
          return {
            anchor: { ...fallback },
            mode: "camera-midpoint",
            offset
          };
        }

        const hasAbsolute =
          Number.isFinite(Number(raw?.x)) ||
          Number.isFinite(Number(raw?.y)) ||
          Number.isFinite(Number(raw?.z));

        return {
          anchor: hasAbsolute
            ? {
                x: Number.isFinite(Number(raw?.x)) ? Number(raw.x) : fallback.x,
                y: Number.isFinite(Number(raw?.y)) ? Number(raw.y) : fallback.y,
                z: Number.isFinite(Number(raw?.z)) ? Number(raw.z) : fallback.z
              }
            : { ...fallback },
          mode: "absolute",
          offset
        };
      }

      function currentFixedAnchor(obj: SceneObject) {
        if (obj.anchorMode !== "camera-midpoint") return { ...obj.anchor };

        const halfDistance = presentationSettings.camera.distanceFromCenter * 0.5;
        const sign = obj.hemisphere === "back" ? -1 : 1;
        return {
          x: obj.anchorOffset?.x ?? 0,
          y: obj.anchorOffset?.y ?? 0,
          z: sign * halfDistance + (obj.anchorOffset?.z ?? 0)
        };
      }

      function generateLayout(station: any, index: number): SceneObject[] {
        const rand = rngFor(station, index);
        const discovered = Array.isArray(assetsByArtwork[station.artworkName])
          ? assetsByArtwork[station.artworkName]
          : [];
        const requestedDisplayMode = station.assetDisplayMode ?? arrangement.assetDisplayMode;
        const displayMode = requestedDisplayMode === "assets-and-proxies"
          ? "assets-and-proxies"
          : "assets-only";
        const configuredProxyCount = Math.max(
          0,
          Math.floor(Number(arrangement.proxyCount ?? sphere.defaultObjectCount ?? 10))
        );
        const fallbackProxyCount = discovered.length === 0
          ? (configuredProxyCount || Number(sphere.defaultObjectCount) || 10)
          : 0;
        const extraProxyCount = displayMode === "assets-and-proxies"
          ? configuredProxyCount
          : fallbackProxyCount;
        const sceneItems = [
          ...discovered.map((asset: any) => ({ asset })),
          ...Array.from({ length: extraProxyCount }, () => ({ asset: undefined }))
        ];
        const result: SceneObject[] = [];
        const threeSettings = resolve3dSettings(station);
        const uploaded3dCount = discovered.filter((asset: any) => asset?.kind === "3d").length;
        let uploaded3dIndex = 0;

        for (let i = 0; i < sceneItems.length; i++) {
          const asset = sceneItems[i].asset;
          const kind: "2d" | "3d" = asset?.kind === "2d" ? "2d" : "3d";
          const objectName = asset?.name ?? `${station.artworkName}-proxy-${i + 1}`;
          const initialLocal = kind === "3d" && asset
            ? placeUploaded3d(uploaded3dIndex++, uploaded3dCount, threeSettings.layer)
            : kind === "3d"
              ? applyDepthLayer(randomPlacement(rand), threeSettings.layer)
              : randomPlacement(rand);
          const anchorConfig = resolveConfiguredAnchor(objectName, initialLocal);
          const objectMotion = normalizeObjectMotion(
            assetMotionState[objectName] ?? config.assetMotion?.[objectName]
          );
          const obj: SceneObject = {
            id: `${station.id}-asset-${i}`,
            name: objectName,
            kind,
            url: asset?.url,
            local: { ...initialLocal },
            velocity: { x: 0, y: 0, z: 0 },
            size: 0.42 + rand() * 0.7,
            shape: Math.floor(rand() * 4),
            spin: rand() * Math.PI * 2,
            spinVelocity: (rand() - 0.5) * 0.28,
            phase: rand() * Math.PI * 2,
            action: asset ? assetActions[asset.name] : undefined,
            depthLayer: kind === "3d" ? threeSettings.layer : undefined,
            hideBehindImage: kind === "3d" ? threeSettings.hideBehindImage : undefined,
            hemisphere: assetPlacement[objectName]?.hemisphere ?? "front",
            visible: assetPlacement[objectName]?.visible ?? true,
            motion: objectMotion,
            anchor: anchorConfig.anchor,
            anchorMode: anchorConfig.mode,
            anchorOffset: anchorConfig.offset
          };
          if (obj.motion.type === "fixed") {
            obj.local = currentFixedAnchor(obj);
          }
          enforceHemisphere(obj);
          obj.anchor = obj.anchorMode === "camera-midpoint"
            ? currentFixedAnchor(obj)
            : { ...obj.local };

          if (kind === "2d" && asset?.url) {
            const image = new Image();
            image.src = asset.url;
            obj.image = image;
          }

          result.push(obj);
        }

        return result;
      }

      function twistAt(z: number) {
        return Math.sin(z * 0.035) * 0.58 + Math.sin(z * 0.013) * 0.22;
      }

      function topFacePoint(z: number): Vec3 {
        const twist = twistAt(z);
        return {
          x: Math.sin(twist) * prismRadius,
          y: Math.cos(twist) * prismRadius,
          z
        };
      }

      function stationCenter(index: number): Vec3 {
        const z = stationZ(index);
        const railPoint = topFacePoint(z);
        return { x: railPoint.x, y: railPoint.y + 0.9, z };
      }

      function hemisphereEditorPose() {
        if (presentationSettings.editor.mode !== "hemisphere") return null;
        const center = stationCenter(arrivingAt);
        const position = hemisphereEditorCameraPosition(
          center,
          presentationSettings.sphere.radius,
          presentationSettings.editor.cameraPreset,
          presentationSettings.editor.hemisphere
        );
        const angles = lookAnglesAt(center, position);
        return { center, position, ...angles };
      }

      function resize() {
        const rect = gameCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        const pixelW = Math.floor(width * dpr);
        const pixelH = Math.floor(height * dpr);

        if (gameCanvas.width !== pixelW || gameCanvas.height !== pixelH) {
          gameCanvas.width = pixelW;
          gameCanvas.height = pixelH;
        }

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (threeRenderer && threeCamera) {
          threeRenderer.setPixelRatio(dpr);
          threeRenderer.setSize(width, height, false);
          const focal = Math.min(width, height) * 0.92;
          threeCamera.aspect = width / Math.max(1, height);
          threeCamera.fov = 2 * Math.atan(height / (2 * focal)) * 180 / Math.PI;
          threeCamera.updateProjectionMatrix();
        }
      }

      function outsideDistanceToFitSphere() {
        if (presentationSettings.camera.placement !== "outside") {
          return presentationSettings.camera.distanceFromCenter;
        }

        const radius = presentationSettings.sphere.radius;
        const minViewport = Math.max(1, Math.min(width, height));
        const focal = minViewport * 0.92;
        const padding = Math.max(28, minViewport * 0.045);
        const allowedRadiusPx = Math.max(1, minViewport * 0.5 - padding);
        const required = radius * Math.sqrt(
          1 + Math.pow(focal / allowedRadiusPx, 2)
        );
        return Math.max(
          presentationSettings.camera.distanceFromCenter,
          required + Math.max(0.15, radius * 0.04)
        );
      }

      function cameraPosition(): Vec3 {
        const editPose = hemisphereEditorPose();
        if (editPose) return editPose.position;

        const center = stationCenter(arrivingAt);
        const animatedDistance = cameraZ - stationZ(arrivingAt);
        const distance = presentationSettings.camera.placement === "outside"
          ? Math.max(animatedDistance, outsideDistanceToFitSphere())
          : animatedDistance;
        return {
          x: center.x,
          y: center.y,
          z: center.z + distance
        };
      }

      function cameraSpace(point: Vec3) {
        const camera = cameraPosition();
        const dx = point.x - camera.x;
        const dy = point.y - camera.y;
        const dz = point.z - camera.z;

        const cy = Math.cos(-lookYaw);
        const sy = Math.sin(-lookYaw);
        const x1 = dx * cy - dz * sy;
        const z1 = dx * sy + dz * cy;

        const cp = Math.cos(-lookPitch);
        const sp = Math.sin(-lookPitch);
        const y2 = dy * cp - z1 * sp;
        const z2 = dy * sp + z1 * cp;

        return { x: x1, y: y2, z: z2, depth: -z2 };
      }

      function project(point: Vec3): Projected | null {
        const transformed = cameraSpace(point);
        const x1 = transformed.x;
        const y2 = transformed.y;
        const depth = transformed.depth;
        if (depth < 0.35) return null;

        const focal = Math.min(width, height) * 0.92;
        const scale = focal / depth;
        return {
          x: width * 0.5 + x1 * scale,
          y: height * 0.5 - y2 * scale,
          depth,
          scale
        };
      }

      function projectedObjectBounds(center: Vec3, obj: SceneObject) {
        const worldCenter = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        const centerProjection = project(worldCenter);
        if (!centerProjection) return null;

        if (obj.kind === "3d" && obj.modelBounds) {
          const b = obj.modelBounds;
          const corners = [
            [b.min.x, b.min.y, b.min.z],
            [b.min.x, b.min.y, b.max.z],
            [b.min.x, b.max.y, b.min.z],
            [b.min.x, b.max.y, b.max.z],
            [b.max.x, b.min.y, b.min.z],
            [b.max.x, b.min.y, b.max.z],
            [b.max.x, b.max.y, b.min.z],
            [b.max.x, b.max.y, b.max.z]
          ];
          const cos = Math.cos(obj.spin);
          const sin = Math.sin(obj.spin);
          let minX = Infinity, minY = Infinity;
          let maxX = -Infinity, maxY = -Infinity;
          let count = 0;

          for (const [bx, by, bz] of corners) {
            const sx = bx * obj.size;
            const sy = by * obj.size;
            const sz = bz * obj.size;
            const rx = sx * cos + sz * sin;
            const rz = -sx * sin + sz * cos;
            const p = project({
              x: worldCenter.x + rx,
              y: worldCenter.y + sy,
              z: worldCenter.z + rz
            });
            if (!p) continue;
            count++;
            minX = Math.min(minX, p.x);
            minY = Math.min(minY, p.y);
            maxX = Math.max(maxX, p.x);
            maxY = Math.max(maxY, p.y);
          }

          if (count > 0) return { minX, minY, maxX, maxY, centerProjection };
        }

        const radius = Math.max(10, objectBodyRadius(obj) * centerProjection.scale);
        return {
          minX: centerProjection.x - radius,
          minY: centerProjection.y - radius,
          maxX: centerProjection.x + radius,
          maxY: centerProjection.y + radius,
          centerProjection
        };
      }

      function pullIntoProjectableView(center: Vec3, obj: SceneObject) {
        const world = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        if (project(world)) return;

        // Pull toward the image center without changing hemisphere sign.
        for (let i = 0; i < 10; i++) {
          obj.local.x *= 0.78;
          obj.local.y *= 0.78;
          obj.local.z *= 0.78;
          enforceHemisphere(obj);
          constrainToSphere(obj);
          const candidate = {
            x: center.x + obj.local.x,
            y: center.y + obj.local.y,
            z: center.z + obj.local.z
          };
          if (project(candidate)) return;
        }
      }

      function constrainToViewport(center: Vec3, obj: SceneObject) {
        if (!presentationSettings.viewport.enabled) return;

        pullIntoProjectableView(center, obj);
        const bounds = projectedObjectBounds(center, obj);
        if (!bounds) return;

        const pad = presentationSettings.viewport.paddingPx;
        let dx = 0;
        let dy = 0;

        if (bounds.minX < pad) dx = pad - bounds.minX;
        else if (bounds.maxX > width - pad) dx = (width - pad) - bounds.maxX;

        if (bounds.minY < pad) dy = pad - bounds.minY;
        else if (bounds.maxY > height - pad) dy = (height - pad) - bounds.maxY;

        if (dx === 0 && dy === 0) return;

        const worldPerPixel = 1 / Math.max(bounds.centerProjection.scale, 0.0001);

        // Screen right/left maps to camera-local x. With locked/focus modes this is
        // effectively world x/y; small iterative passes below handle look offsets.
        obj.local.x += dx * worldPerPixel;
        obj.local.y -= dy * worldPerPixel;

        if (dx !== 0) obj.velocity.x *= -0.55;
        if (dy !== 0) obj.velocity.y *= -0.55;
      }

      function drawBackground() {
        const g = ctx.createRadialGradient(
          width * 0.5, height * 0.42, 10,
          width * 0.5, height * 0.5, Math.max(width, height) * 0.78
        );
        g.addColorStop(0, "#18202b");
        g.addColorStop(0.45, "#090d13");
        g.addColorStop(1, "#020304");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = "rgba(255,255,255,.14)";
        for (let i = 0; i < 42; i++) {
          const x = (i * 193.1) % width;
          const y = (i * 91.7) % height;
          ctx.fillRect(x, y, i % 4 === 0 ? 1.5 : 1, i % 4 === 0 ? 1.5 : 1);
        }
      }

      function drawRail() {
        const start = Math.floor(cameraZ / 4) * 4 + 8;
        const points: Projected[] = [];

        for (let z = start; z >= cameraZ - spacing * (stations.length + 2); z -= 1.2) {
          const p = project(topFacePoint(z));
          if (p) points.push(p);
        }

        if (points.length > 1) {
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
          ctx.strokeStyle = "rgba(232,218,192,.68)";
          ctx.lineWidth = 1.25;
          ctx.stroke();
        }
      }

      function themeColors(theme: string) {
        if (theme === "blue") return ["#203954", "#7ea6d7", "#0d1520"];
        if (theme === "rose") return ["#512937", "#c77f94", "#180d13"];
        return ["#5a3a22", "#d5a268", "#1b120c"];
      }

      function constrainToSphere(obj: SceneObject) {
        const radius = sphereRadius();
        let bodyRadius = objectBodyRadius(obj);
        const maximumBodyRadius = maxBodyRadiusForSphere(radius);

        // If the sphere is resized smaller than an existing model, fit the model
        // first. This preserves the invariant that the complete GLB remains inside.
        if (bodyRadius > maximumBodyRadius && bodyRadius > 0) {
          obj.size *= maximumBodyRadius / bodyRadius;
          bodyRadius = maximumBodyRadius;
        }

        const constrained = constrainBodyToHemisphereSphere(
          {
            position: obj.local,
            velocity: obj.velocity
          },
          obj.hemisphere === "back" ? "back" : "front",
          radius,
          bodyRadius,
          presentationSettings.sphere.restitution
        );

        obj.local = constrained.position;
        obj.velocity = constrained.velocity;
      }

      function solveObjectBounds(stationIndex: number, obj: SceneObject) {
        const center = stationCenter(stationIndex);

        // Rule 1 is always authoritative.
        enforceHemisphere(obj);
        constrainToSphere(obj);

        // Rule 2 is optional and only applies to the section currently being viewed.
        if (presentationSettings.viewport.enabled && stationIndex === arrivingAt) {
          for (let pass = 0; pass < 5; pass++) {
            constrainToViewport(center, obj);
            enforceHemisphere(obj);
            constrainToSphere(obj);
          }
          // Final viewport correction followed by a final sphere guarantee.
          constrainToViewport(center, obj);
          enforceHemisphere(obj);
          constrainToSphere(obj);
        }
      }

      function updateObjects(now: number, dt: number) {
        const damping = Math.pow(Number(motion.tossDamping) || 0.992, dt * 60);
        const floatStrength = Number(motion.floatStrength) || 0.08;
        const floatSpeed = Number(motion.floatSpeed) || 0.22;

        for (let stationIndex = 0; stationIndex < layouts.length; stationIndex++) {
          const layout = layouts[stationIndex];
          const center = stationCenter(stationIndex);
          for (const obj of layout) {
            if (obj.visible === false) continue;
            if (grabbed?.object === obj) continue;

            if (obj.motion.type === "fixed") {
              obj.velocity = { x: 0, y: 0, z: 0 };
              const anchor = currentFixedAnchor(obj);
              obj.anchor = { ...anchor };
              obj.local = fixedPositionAtTime(
                anchor,
                obj.motion,
                obj.phase,
                now * 0.001
              );
            } else {
              obj.velocity.x *= damping;
              obj.velocity.y *= damping;
              obj.velocity.z *= damping;

              const t = now * 0.001 * floatSpeed + obj.phase;
              obj.velocity.y += Math.sin(t) * floatStrength * dt;
              obj.velocity.x += Math.cos(t * 0.77) * floatStrength * 0.42 * dt;

              obj.local.x += obj.velocity.x * dt;
              obj.local.y += obj.velocity.y * dt;
              obj.local.z += obj.velocity.z * dt;
            }

            if (obj.kind === "3d") obj.spin += obj.spinVelocity * dt;
            solveObjectBounds(stationIndex, obj);
          }
        }
      }

      function drawSceneObject(center: Vec3, obj: SceneObject, alpha: number, now: number) {
        if (obj.visible === false) {
          obj.lastScreen = undefined;
          return;
        }
        const world = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        const p = project(world);
        if (!p || p.depth > 60) {
          obj.lastScreen = undefined;
          return;
        }

        const size = Math.max(8, obj.size * p.scale);
        obj.lastScreen = { x: p.x, y: p.y, radius: size * 1.15, depth: p.depth };

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.globalAlpha = alpha;

        if (obj.kind === "2d") {
          const wobbleDeg = Number(billboard.wobbleDegrees) || 1.4;
          const wobbleSpeed = Number(billboard.wobbleSpeed) || 0.28;
          const maxYaw = Number(billboard.maxYawDegrees) || 5;
          const wobble = Math.sin(now * 0.001 * wobbleSpeed + obj.phase) * wobbleDeg;
          const tossTilt = Math.max(-maxYaw, Math.min(maxYaw, obj.velocity.x * 1.4));
          const rotation = (wobble + tossTilt) * Math.PI / 180;
          ctx.rotate(rotation);

          if (obj.image?.complete && obj.image.naturalWidth > 0) {
            const aspect = obj.image.naturalWidth / obj.image.naturalHeight;
            const h = size * 1.7;
            const w = h * aspect;
            ctx.drawImage(obj.image, -w / 2, -h / 2, w, h);
            ctx.strokeStyle = "rgba(255,255,255,.25)";
            ctx.strokeRect(-w / 2, -h / 2, w, h);
          } else {
            ctx.fillStyle = "rgba(225,232,244,.88)";
            ctx.fillRect(-size, -size * .72, size * 2, size * 1.44);
            ctx.strokeStyle = "rgba(255,255,255,.28)";
            ctx.strokeRect(-size, -size * .72, size * 2, size * 1.44);
          }
        } else if (obj.url) {
          ensureThreeObject(obj);
          const model = threeObjects.get(obj.id);
          if (model) {
            model.visible = true;
            model.position.set(world.x, world.y, world.z);
            model.rotation.set(0, obj.spin, 0);
            model.scale.setScalar(obj.size);
          }

          if (
            presentationSettings.debug.glbGlobe.enabled &&
            presentationSettings.debug.glbGlobe.objectName === obj.name
          ) {
            const globe = ensureDebugGlobe(obj);
            if (globe) {
              const debugRadius = Math.max(
                0.18,
                (Number.isFinite(obj.modelRadius) ? Number(obj.modelRadius) : 1) * obj.size
              );
              globe.visible = true;
              globe.position.set(world.x, world.y, world.z);
              globe.scale.setScalar(debugRadius);
            }
          }
        } else {
          // No uploaded 3D asset exists for this slot, so render a mathematical
          // proxy placeholder. Uploaded GLB/GLTF assets are rendered by Three.js.
          ctx.rotate(obj.spin);
          if (obj.shape === 0) {
            const g = ctx.createRadialGradient(-size * .2, -size * .25, 0, 0, 0, size);
            g.addColorStop(0, "#d9e4f2");
            g.addColorStop(1, "#26303e");
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.fill();
          } else if (obj.shape === 1) {
            ctx.fillStyle = "#4d5968";
            ctx.fillRect(-size, -size * .6, size * 2, size * 1.2);
          } else if (obj.shape === 2) {
            ctx.strokeStyle = "rgba(198,211,226,.72)";
            ctx.lineWidth = Math.max(1, size * .16);
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            ctx.fillStyle = "#747b85";
            ctx.beginPath();
            ctx.moveTo(0, -size);
            ctx.lineTo(size * .82, size * .72);
            ctx.lineTo(-size * .82, size * .72);
            ctx.closePath();
            ctx.fill();
          }
        }

        if (obj.action) {
          ctx.strokeStyle = "rgba(255,255,255,.34)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(0, 0, size * 1.22, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.restore();
      }

      function wrapText(text: string, x: number, y: number, maxWidth: number, lineHeight: number) {
        const words = String(text).split(/\s+/);
        let line = "";
        let yy = y;
        for (const word of words) {
          const test = line ? `${line} ${word}` : word;
          if (ctx.measureText(test).width > maxWidth && line) {
            ctx.fillText(line, x, yy);
            line = word;
            yy += lineHeight;
          } else {
            line = test;
          }
        }
        if (line) ctx.fillText(line, x, yy);
      }

      function ensureHorizontalTextPlane(station: any, center: Vec3, current: boolean) {
        if (!threeScene) return;
        const settings = stationSettings[station.id]?.textPlane ?? defaultsForStation(station).textPlane;
        const text = current && paperTextOverride ? paperTextOverride : station.text ?? {};
        const title = String(text.title ?? station.label ?? "");
        const body = String(text.body ?? "");
        const signature = [title, body, settings.color, settings.width, settings.height].join("|");
        let entry = textPlanes.get(station.id);

        if (!entry || entry.signature !== signature) {
          if (entry) {
            threeScene.remove(entry.mesh);
            entry.mesh.geometry?.dispose?.();
            entry.mesh.material?.dispose?.();
            entry.texture?.dispose?.();
          }

          const textureCanvas = document.createElement("canvas");
          textureCanvas.width = 1024;
          textureCanvas.height = 256;
          const tctx = textureCanvas.getContext("2d");
          if (!tctx) return;
          tctx.fillStyle = settings.color;
          tctx.fillRect(0, 0, 1024, 256);

          const raw = settings.color.replace("#", "");
          const rr = parseInt(raw.slice(0,2),16) || 255;
          const gg = parseInt(raw.slice(2,4),16) || 255;
          const bb = parseInt(raw.slice(4,6),16) || 255;
          const lum = (0.2126*rr + 0.7152*gg + 0.0722*bb)/255;
          tctx.fillStyle = lum > 0.55 ? "#171717" : "#f7f7f7";
          tctx.textBaseline = "top";
          tctx.font = "700 46px ui-sans-serif, system-ui";
          tctx.fillText(title, 54, 34, 916);
          tctx.font = "30px ui-sans-serif, system-ui";
          const words = body.split(/\s+/);
          let line = "", y = 108;
          for (const word of words) {
            const candidate = line ? `${line} ${word}` : word;
            if (tctx.measureText(candidate).width > 916 && line) {
              tctx.fillText(line, 54, y);
              line = word; y += 40;
              if (y > 205) break;
            } else line = candidate;
          }
          if (line && y <= 205) tctx.fillText(line, 54, y);

          const T3:any = THREE;
          const texture = new T3.CanvasTexture(textureCanvas);
          const geometry = new T3.PlaneGeometry(settings.width, settings.height);
          const material = new T3.MeshBasicMaterial({ map:texture, side:T3.DoubleSide });
          const mesh = new T3.Mesh(geometry, material);
          mesh.renderOrder = 30;
          threeScene.add(mesh);
          entry = { mesh, texture, signature };
          textPlanes.set(station.id, entry);
        }

        entry.mesh.visible = true;
        entry.mesh.position.set(center.x, center.y + settings.offsetY, center.z + settings.offsetZ);
        entry.mesh.rotation.set(-Math.PI / 2, 0, 0);
      }

      function projectedSideImagePlane(center: Vec3, widthWorld = 5.4, heightWorld = 5.9) {
        const hw = widthWorld * 0.5;
        const hh = heightWorld * 0.5;
        const corners = [
          project({ x: center.x - hw, y: center.y - hh, z: center.z }),
          project({ x: center.x + hw, y: center.y - hh, z: center.z }),
          project({ x: center.x + hw, y: center.y + hh, z: center.z }),
          project({ x: center.x - hw, y: center.y + hh, z: center.z })
        ];
        if (corners.some((corner) => !corner)) return null;
        return corners as [Projected, Projected, Projected, Projected];
      }

      function drawSidePerspectiveImage(station: any, center: Vec3, alpha: number) {
        const corners = projectedSideImagePlane(center);
        if (!corners) return false;
        const [bottomLeft, bottomRight, topRight, topLeft] = corners;
        const colors = themeColors(station.theme);

        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.moveTo(bottomLeft.x, bottomLeft.y);
        ctx.lineTo(bottomRight.x, bottomRight.y);
        ctx.lineTo(topRight.x, topRight.y);
        ctx.lineTo(topLeft.x, topLeft.y);
        ctx.closePath();

        ctx.lineWidth = Math.max(2, Math.min(10, Math.min(width, height) * 0.01));
        ctx.strokeStyle = "#141414";
        ctx.stroke();

        const art = ctx.createLinearGradient(topLeft.x, topLeft.y, bottomRight.x, bottomRight.y);
        art.addColorStop(0, colors[0]);
        art.addColorStop(.52, colors[1]);
        art.addColorStop(1, colors[2]);
        ctx.fillStyle = art;
        ctx.fill();

        ctx.lineWidth = 1.1;
        ctx.strokeStyle = "rgba(255,255,255,.25)";
        ctx.stroke();

        const dx = bottomRight.x - bottomLeft.x;
        const dy = bottomRight.y - bottomLeft.y;
        const edgeLength = Math.hypot(dx, dy);
        if (edgeLength > 42) {
          ctx.translate(bottomLeft.x + dx * 0.08, bottomLeft.y + dy * 0.08);
          ctx.rotate(Math.atan2(dy, dx));
          ctx.fillStyle = "rgba(255,255,255,.86)";
          ctx.font = `${Math.max(10, Math.min(18, edgeLength * 0.045))}px ui-sans-serif, system-ui`;
          ctx.textAlign = "left";
          ctx.fillText(station.label, 0, -8);
        }
        ctx.restore();
        return true;
      }

      function drawStation(index: number, now: number) {
        const station = stations[index];
        const center = stationCenter(index);
        const cp = project(center);
        if (!cp || cp.depth > 54) return;

        const alpha = Math.max(.12, Math.min(1, 1 - cp.depth / 60));
        const station3dSettings = resolve3dSettings(station);
        const hasVisibleBackAsset = layouts[index].some(
          (obj: SceneObject) => obj.visible !== false && obj.hemisphere === "back"
        );
        if (station3dSettings.hideBehindImage || hasVisibleBackAsset) ensureImageOccluder(index, center);
        for (const obj of layouts[index]) drawSceneObject(center, obj, alpha * .84, now);

        const colors = themeColors(station.theme);
        const scale = cp.scale;
        const current = index === arrivingAt;
        const lift = current ? paperOpen * 0.85 * scale : 0;

        const imageW = 5.4 * scale;
        const imageH = 5.9 * scale;
        const imageX = cp.x - imageW * .5;
        const imageY = cp.y - imageH * .5 - lift;

        const sidePerspective =
          current &&
          presentationSettings.editor.mode === "hemisphere" &&
          presentationSettings.editor.cameraPreset === "side" &&
          drawSidePerspectiveImage(station, center, alpha);

        ctx.save();
        ctx.globalAlpha = alpha;

        if (!sidePerspective) {
          ctx.fillStyle = "#141414";
          ctx.fillRect(imageX - 10, imageY - 10, imageW + 20, imageH + 20);

          const art = ctx.createLinearGradient(imageX, imageY, imageX + imageW, imageY + imageH);
          art.addColorStop(0, colors[0]);
          art.addColorStop(.52, colors[1]);
          art.addColorStop(1, colors[2]);
          ctx.fillStyle = art;
          ctx.fillRect(imageX, imageY, imageW, imageH);

          ctx.fillStyle = "rgba(255,255,255,.86)";
          ctx.font = `${Math.max(11, Math.min(22, scale * .24))}px ui-sans-serif, system-ui`;
          ctx.textAlign = "left";
          ctx.fillText(station.label, imageX + 16, imageY + imageH - 18);
        }

        // Separate horizontal plaque; main image above is untouched.
        ensureHorizontalTextPlane(station, center, current);

        ctx.restore();
      }

      function arrived() {
        return Math.abs(cameraZ - targetZ) < 0.08;
      }

      function requestStation(index: number) {
        arrivingAt = Math.max(0, Math.min(stations.length - 1, index));
        activeStationId = stations[arrivingAt]?.id ?? activeStationId;
        presentationSettings =
          stationSettings[activeStationId] ??
          defaultsForStation(stations[arrivingAt]);
        stationSettings[activeStationId] = presentationSettings;
        targetZ = stationZ(arrivingAt) + presentationSettings.camera.distanceFromCenter;
        paperTextOverride = null;
        status && (status.textContent = `Traveling to ${stations[arrivingAt].label}`);
        renderSphereSettings();
      }

      function executeAction(action: AssetAction | undefined) {
        if (!action) return;
        if (action.type === "station") {
          const index = stations.findIndex((station: any) => station.id === action.stationId);
          if (index >= 0) requestStation(index);
          return;
        }
        if (action.type === "link") {
          const destination = resolvedLinks[action.linkKey];
          if (typeof destination === "string") window.location.assign(destination);
          return;
        }
        if (action.type === "url") {
          if (typeof action.url === "string") window.location.assign(action.url);
          return;
        }
        if (action.type === "text") {
          paperTextOverride = { title: action.title, body: action.body };
        }
      }

      function findHitObject(x: number, y: number) {
        const objects = layouts[arrivingAt]
          .filter((obj: SceneObject) => obj.visible !== false && obj.lastScreen)
          .sort((a: SceneObject, b: SceneObject) => (a.lastScreen?.depth ?? 999) - (b.lastScreen?.depth ?? 999));

        for (const obj of objects) {
          const s = obj.lastScreen;
          if (!s) continue;
          if (Math.hypot(x - s.x, y - s.y) <= s.radius) return obj;
        }
        return null;
      }

      function update(now: number, dt: number) {
        const editPose = hemisphereEditorPose();
        if (editPose) {
          targetYaw = editPose.yaw;
          targetPitch = editPose.pitch;
        } else if (presentationSettings.camera.mode === "locked") {
          targetYaw = 0;
          targetPitch = 0;
        }

        const dz = targetZ - cameraZ;
        if (Math.abs(dz) > 0.04) {
          cameraZ += Math.sign(dz) * Math.min(Math.abs(dz), rideSpeed * dt);
        } else {
          cameraZ = targetZ;
        }

        lookYaw += (targetYaw - lookYaw) * Math.min(1, dt * 4.0);
        lookPitch += (targetPitch - lookPitch) * Math.min(1, dt * 4.0);
        updateObjects(now, dt);
      }

      function drawHud() {
        ctx.save();
        ctx.fillStyle = "rgba(255,255,255,.88)";
        ctx.font = "600 14px ui-sans-serif, system-ui";
        ctx.fillText("Do It Your Way", 24, 30);
        ctx.fillStyle = "rgba(255,255,255,.48)";
        ctx.font = "12px ui-sans-serif, system-ui";
        ctx.fillText("PRISM RAIL / TOP FACE", 24, 50);

        const mouseHint =
          presentationSettings.camera.mode === "locked"
            ? ""
            : presentationSettings.camera.mode === "focus"
              ? " · move mouse to look"
              : " · move mouse for free look";
        const hint = arrived()
          ? presentationSettings.editor.mode === "hemisphere"
            ? `HEMISPHERE EDITOR · ${presentationSettings.editor.hemisphere.toUpperCase()} · right-click for cameras/reposition`
            : `Click the paper to present it · drag or toss floating objects${mouseHint} · ← → ride`
          : "Riding the thread…";

        ctx.textAlign = "center";
        ctx.fillText(hint, width * .5, height - 24);
        ctx.textAlign = "right";
        ctx.fillText(`${arrivingAt + 1} / ${stations.length}`, width - 24, 30);
        ctx.restore();
      }

      function render(now: number) {
        resize();
        const dt = Math.min((now - previous) / 1000, 1 / 30);
        previous = now;
        update(now, dt);

        for (const model of threeObjects.values()) model.visible = false;
        for (const entry of textPlanes.values()) entry.mesh.visible = false;
        for (const globe of debugGlobes.values()) globe.visible = false;
        for (const occluder of occluders.values()) occluder.visible = false;
        for (const layout of layouts) {
          for (const obj of layout) obj.lastScreen = undefined;
        }

        drawBackground();
        drawRail();

        const drawOrder = stations
          .map((_: any, index: number) => index)
          .sort((a: number, b: number) => stationZ(a) - stationZ(b));

        for (const index of drawOrder) drawStation(index, now);

        if (threeRenderer && threeScene && threeCamera) {
          const cam = cameraPosition();
          threeCamera.position.set(cam.x, cam.y, cam.z);
          threeCamera.rotation.order = "YXZ";
          threeCamera.rotation.set(lookPitch, lookYaw, 0);
          threeRenderer.render(threeScene, threeCamera);
        }

        const vignette = ctx.createRadialGradient(
          width * .5, height * .5, Math.min(width, height) * .25,
          width * .5, height * .5, Math.max(width, height) * .72
        );
        vignette.addColorStop(0, "rgba(0,0,0,0)");
        vignette.addColorStop(1, "rgba(0,0,0,.6)");
        ctx.fillStyle = vignette;
        ctx.fillRect(0, 0, width, height);

        drawHud();
        requestAnimationFrame(render);
      }

      function pointIn(rect: { x: number; y: number; w: number; h: number } | null, x: number, y: number) {
        return !!rect && x >= rect.x && x <= rect.x + rect.w && y >= rect.y && y <= rect.y + rect.h;
      }

      function closeEditContextMenu() {
        if (editContextMenu) editContextMenu.hidden = true;
      }

      function addEditContextAction(label: string, action: () => void, active = false) {
        if (!editContextMenu) return;
        const button = document.createElement("button");
        button.type = "button";
        button.className = active ? "edit-context-action is-active" : "edit-context-action";
        button.textContent = label;
        button.addEventListener("click", () => {
          action();
          closeEditContextMenu();
        });
        editContextMenu.appendChild(button);
      }

      function openEditContextMenu(clientX: number, clientY: number, obj: SceneObject | null) {
        if (!editContextMenu) return;
        const api = window.webrevPresentationSettings;
        if (!api) return;

        editContextMenu.replaceChildren();
        const editor = api.getEditorState();

        addEditContextAction(
          "Hemisphere Editor · Front",
          () => api.setEditorMode("hemisphere", "front"),
          editor.mode === "hemisphere" && editor.hemisphere === "front"
        );
        addEditContextAction(
          "Hemisphere Editor · Back",
          () => api.setEditorMode("hemisphere", "back"),
          editor.mode === "hemisphere" && editor.hemisphere === "back"
        );
        addEditContextAction(
          "Exit Edit Layer",
          () => api.setEditorMode("none"),
          editor.mode === "none"
        );

        if (obj) {
          const repositioning =
            editor.mode === "hemisphere" &&
            editor.repositionObjectName === obj.name;
          addEditContextAction(
            `Reposition ${repositioning ? "OFF" : "ON"} · ${obj.name}`,
            () => {
              if (editor.mode !== "hemisphere") {
                api.setEditorMode("hemisphere", obj.hemisphere === "back" ? "back" : "front");
              }
              api.setRepositionObject(repositioning ? null : obj.name);
            },
            repositioning
          );
        }

        const heading = document.createElement("div");
        heading.className = "edit-context-heading";
        heading.textContent = "Hemisphere camera";
        editContextMenu.appendChild(heading);

        for (const preset of api.listEditorCameraPresets()) {
          addEditContextAction(
            preset.label,
            () => {
              if (api.getEditorState().mode !== "hemisphere") api.setEditorMode("hemisphere", "front");
              api.setEditorCameraPreset(preset.id);
            },
            editor.mode === "hemisphere" && editor.cameraPreset === preset.id
          );
        }

        editContextMenu.style.left = `${Math.max(8, Math.min(window.innerWidth - 270, clientX))}px`;
        editContextMenu.style.top = `${Math.max(8, Math.min(window.innerHeight - 340, clientY))}px`;
        editContextMenu.hidden = false;
      }

      gameCanvas.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        const rect = gameCanvas.getBoundingClientRect();
        const obj = findHitObject(event.clientX - rect.left, event.clientY - rect.top);
        openEditContextMenu(event.clientX, event.clientY, obj);
      });

      window.addEventListener("pointerdown", (event) => {
        if (!editContextMenu || editContextMenu.hidden) return;
        if (event.target instanceof Node && editContextMenu.contains(event.target)) return;
        closeEditContextMenu();
      });

      gameCanvas.addEventListener("pointerdown", (event) => {
        if (!arrived()) return;
        const rect = gameCanvas.getBoundingClientRect();
        pointerX = event.clientX - rect.left;
        pointerY = event.clientY - rect.top;

        const obj = findHitObject(pointerX, pointerY);
        if (obj) {
          if (presentationSettings.editor.mode === "hemisphere") {
            if (presentationSettings.editor.repositionObjectName !== obj.name) return;
            if (obj.hemisphere !== presentationSettings.editor.hemisphere) return;
          } else if (obj.motion.type === "fixed" && obj.motion.fixedMode === "anchored") {
            return;
          }
          grabbed = { stationIndex: arrivingAt, object: obj };
          dragLastX = pointerX;
          dragLastY = pointerY;
          dragLastTime = performance.now();
          draggedDistance = 0;
          gameCanvas.setPointerCapture(event.pointerId);
        }
      });

      gameCanvas.addEventListener("pointermove", (event) => {
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        pointerX = x;
        pointerY = y;

        if (grabbed) {
          const now = performance.now();
          const dt = Math.max((now - dragLastTime) / 1000, 0.001);
          const dx = x - dragLastX;
          const dy = y - dragLastY;
          const obj = grabbed.object;
          const sensitivity = 0.012;
          if (presentationSettings.editor.mode === "hemisphere") {
            const pose = hemisphereEditorPose();
            if (pose) {
              const basis = screenBasis(pose.center, pose.position);
              const sx = dx * sensitivity;
              const sy = -dy * sensitivity;
              obj.local.x += basis.right.x * sx + basis.up.x * sy;
              obj.local.y += basis.right.y * sx + basis.up.y * sy;
              obj.local.z += basis.right.z * sx + basis.up.z * sy;
            }
          } else {
            obj.local.x += dx * sensitivity;
            obj.local.y -= dy * sensitivity;
          }

          if (presentationSettings.editor.mode === "hemisphere") {
            obj.anchor = { ...obj.local };
            obj.anchorMode = "absolute";
            obj.anchorOffset = { x: 0, y: 0, z: 0 };
            obj.velocity = { x: 0, y: 0, z: 0 };
          } else if (obj.motion.type === "fixed") {
            obj.anchor = { ...obj.local };
            obj.anchorMode = "absolute";
            obj.anchorOffset = { x: 0, y: 0, z: 0 };
            obj.velocity = { x: 0, y: 0, z: 0 };
          } else {
            const maxToss = Number(motion.maxTossSpeed) || 2.6;
            obj.velocity.x = Math.max(-maxToss, Math.min(maxToss, (dx / dt) * 0.0025));
            obj.velocity.y = Math.max(-maxToss, Math.min(maxToss, (-dy / dt) * 0.0025));
          }
          draggedDistance += Math.hypot(dx, dy);
          solveObjectBounds(grabbed.stationIndex, obj);

          dragLastX = x;
          dragLastY = y;
          dragLastTime = now;
          gameCanvas.style.cursor = "grabbing";
          return;
        }

        if (presentationSettings.editor.mode === "none" && presentationSettings.camera.mode !== "locked") {
          const nx = x / Math.max(1, rect.width) - .5;
          const ny = y / Math.max(1, rect.height) - .5;

          if (presentationSettings.camera.mode === "focus") {
            // Limited look mode: keep the center image inside the viewport.
            targetYaw = nx * .34;
            targetPitch = -ny * .20;
          } else {
            // Free mode: full yaw rotation and a wide pitch range.
            targetYaw = nx * Math.PI * 2;
            targetPitch = Math.max(
              -Math.PI * 0.49,
              Math.min(Math.PI * 0.49, -ny * Math.PI)
            );
          }
        }

        const hover = findHitObject(x, y);
        gameCanvas.style.cursor = hover ? "pointer" : "crosshair";
      });

      function releasePointer(event: PointerEvent) {
        if (!grabbed) return;
        const obj = grabbed.object;
        const wasClick = draggedDistance < 6;
        grabbed = null;
        if (gameCanvas.hasPointerCapture(event.pointerId)) gameCanvas.releasePointerCapture(event.pointerId);
        if (wasClick) executeAction(obj.action);
      }

      gameCanvas.addEventListener("pointerup", releasePointer);
      gameCanvas.addEventListener("pointercancel", releasePointer);

      gameCanvas.addEventListener("pointerleave", () => {
        if (!grabbed && presentationSettings.camera.mode === "focus") {
          targetYaw = 0;
          targetPitch = 0;
        }
      });

      gameCanvas.addEventListener("click", (event) => {
        if (!arrived() || draggedDistance >= 6) return;
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        if (findHitObject(x, y)) return;

        
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") {
          event.preventDefault();
          requestStation(Math.min(stations.length - 1, arrivingAt + 1));
        }
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          requestStation(Math.max(0, arrivingAt - 1));
        }
        if (event.key === "Home") requestStation(0);
      });

      requestStation(0);
      requestAnimationFrame(render);
    }
  }
</script>

