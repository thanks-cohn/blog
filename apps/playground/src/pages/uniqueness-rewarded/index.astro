---
import { resolveLink } from "@webrev/core";
import linksConfig from "../../../../../config/links.json";
import presentationConfig from "../../../../../config/presentations/uniqueness-rewarded.json";
import SpatialPresentation from "../../components/SpatialPresentation.astro";

const homeHref = resolveLink(linksConfig, "home", import.meta.env.BASE_URL);
const resolvedLinks = Object.fromEntries(
  Object.keys(linksConfig.links).map((key) => [
    key,
    resolveLink(linksConfig, key, import.meta.env.BASE_URL)
  ])
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Design it Your Way · WebRev</title>
    <style>
      :root { color-scheme: dark; background:#040506; }
      html, body { margin:0; width:100%; height:100%; overflow:hidden; background:#040506; }
      body { min-height:100vh; }
    </style>
  </head>
  <body>
    <SpatialPresentation config={presentationConfig} homeHref={homeHref} links={resolvedLinks} />
  </body>
</html>
