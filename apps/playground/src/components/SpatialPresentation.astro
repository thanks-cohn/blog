---
export interface Props {
  config: any;
  homeHref: string;
  links: Record<string, string>;
}

const { config, homeHref, links } = Astro.props;

type DiscoveredAsset = { name: string; url: string; kind: "2d" | "3d" };

const discovered2d = import.meta.glob("../assets/2d-assets/*.{png,jpg,jpeg,webp,avif,svg}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const discovered3d = import.meta.glob("../assets/3d-assets/*.{glb,gltf}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;

const assetsByArtwork: Record<string, DiscoveredAsset[]> = {};

function registerAsset(path: string, url: string, kind: "2d" | "3d") {
  const file = path.split("/").pop() ?? "";
  const base = file.replace(/\.[^.]+$/, "");
  const match = base.match(/^(.*?)-(\d+)$/);
  if (!match) return;
  const artworkName = match[1];
  (assetsByArtwork[artworkName] ??= []).push({ name: file, url, kind });
}

for (const [path, url] of Object.entries(discovered2d)) registerAsset(path, url, "2d");
for (const [path, url] of Object.entries(discovered3d)) registerAsset(path, url, "3d");

const runtimeConfig = { ...config, assetsByArtwork, resolvedLinks: links };
---

<div
  class="presentation"
  data-webrev-id="presentation.do-it-your-way"
  data-config={JSON.stringify(runtimeConfig)}
  data-home-href={homeHref}
>
  <canvas id="prism-rail-canvas" aria-label="Do It Your Way spatial presentation"></canvas>
  <canvas id="glb-layer" aria-hidden="true"></canvas>
  <div class="sr-only" aria-live="polite" id="presentation-status"></div>

  <button
    type="button"
    id="sphere-settings-toggle"
    class="sphere-settings-toggle"
    aria-label="Sphere asset settings"
    aria-expanded="false"
    aria-controls="sphere-settings-panel"
  >⚙</button>

  <aside id="sphere-settings-panel" class="sphere-settings-panel" hidden>
    <div class="sphere-settings-header">
      <div>
        <strong>Sphere assets</strong>
        <div id="sphere-size-readout" class="sphere-size-readout"></div>
      </div>
      <button type="button" id="sphere-settings-close" class="sphere-settings-close" aria-label="Close settings">×</button>
    </div>

    <label class="sphere-asset-add">
      <span>Add / restore asset</span>
      <select id="sphere-asset-picker">
        <option value="">Choose an asset…</option>
      </select>
    </label>

    <section class="sphere-side-section" aria-labelledby="front-assets-title">
      <div class="sphere-side-title" id="front-assets-title">Front</div>
      <div id="front-assets-list" class="sphere-asset-list"></div>
    </section>

    <section class="sphere-side-section" aria-labelledby="back-assets-title">
      <div class="sphere-side-title" id="back-assets-title">Back</div>
      <div id="back-assets-list" class="sphere-asset-list"></div>
    </section>
  </aside>
</div>

<script>
  import * as THREE from "../vendor/three.module.min.js";
  import { GLTFLoader } from "../vendor/GLTFLoader.js";

  type Vec3 = { x: number; y: number; z: number };
  type Projected = { x: number; y: number; depth: number; scale: number };
  type AssetAction =
    | { type: "station"; stationId: string }
    | { type: "link"; linkKey: string }
    | { type: "url"; url: string }
    | { type: "text"; title?: string; body?: string };

  type SceneObject = {
    id: string;
    name: string;
    kind: "2d" | "3d";
    url?: string;
    local: Vec3;
    velocity: Vec3;
    size: number;
    shape: number;
    spin: number;
    spinVelocity: number;
    phase: number;
    image?: HTMLImageElement;
    action?: AssetAction;
    depthLayer?: "near" | "middle" | "far";
    hideBehindImage?: boolean;
    hemisphere?: "front" | "back";
    visible?: boolean;
    lastScreen?: { x: number; y: number; radius: number; depth: number };
  };

  type CameraMode = "locked" | "focus" | "free";
  type PresentationSettingKey =
    | "camera.mode"
    | "camera.mouseMovesCamera"
    | "assets.minDistanceFromCenter"
    | "assets.maxDistanceFromCenter"
    | "collisions.viewport.enabled"
    | "collisions.viewport.restitution"
    | "collisions.viewport.paddingPx"
    | "collisions.sphereInside.enabled";
  type PresentationSettingValue = boolean | number | CameraMode;
  type AssetHemisphere = "front" | "back";
  type AssetPlacementState = Record<string, { hemisphere: AssetHemisphere; visible: boolean }>;
  type PresentationSettingsSnapshot = {
    camera: {
      mode: CameraMode;
      mouseMovesCamera: boolean;
    };
    assets: {
      minDistanceFromCenter: number;
      maxDistanceFromCenter: number;
    };
    collisions: {
      viewport: {
        enabled: boolean;
        restitution: number;
        paddingPx: number;
      };
      sphereInside: {
        enabled: boolean;
      };
    };
  };
  type SettingsListener = (settings: PresentationSettingsSnapshot) => void;

  declare global {
    interface Window {
      webrevPresentationSettings?: {
        get(key?: PresentationSettingKey): PresentationSettingsSnapshot | PresentationSettingValue;
        set(key: PresentationSettingKey, value: PresentationSettingValue): PresentationSettingsSnapshot;
        reset(key?: PresentationSettingKey): PresentationSettingsSnapshot;
        subscribe(listener: SettingsListener): () => void;
        listAssets(stationId?: string): Array<{ name: string; hemisphere: AssetHemisphere; visible: boolean }>;
        setAssetHemisphere(name: string, hemisphere: AssetHemisphere): void;
        setAssetVisible(name: string, visible: boolean): void;
      };
    }
  }

  const root = document.querySelector<HTMLElement>(".presentation[data-config]");
  const canvas = document.getElementById("prism-rail-canvas");
  const glbCanvas = document.getElementById("glb-layer");
  const settingsToggle = document.getElementById("sphere-settings-toggle") as HTMLButtonElement | null;
  const settingsPanel = document.getElementById("sphere-settings-panel") as HTMLElement | null;
  const settingsClose = document.getElementById("sphere-settings-close") as HTMLButtonElement | null;
  const sphereSizeReadout = document.getElementById("sphere-size-readout");
  const assetPicker = document.getElementById("sphere-asset-picker") as HTMLSelectElement | null;
  const frontAssetsList = document.getElementById("front-assets-list");
  const backAssetsList = document.getElementById("back-assets-list");

  let threeRenderer: any = null;
  let threeScene: any = null;
  let threeCamera: any = null;
  let gltfLoader: any = null;
  const threeObjects = new Map<string, any>();
  const threeLoading = new Set<string>();
  const threeLoadAttempts = new Map<string, number>();
  const threeRetryAt = new Map<string, number>();
  const occluders = new Map<number, any>();

  function ensureThree() {
    if (threeRenderer || !(glbCanvas instanceof HTMLCanvasElement)) return;
    const T3: any = THREE;
    threeScene = new T3.Scene();
    threeCamera = new T3.PerspectiveCamera(50, 1, 0.05, 250);
    threeRenderer = new T3.WebGLRenderer({
      canvas: glbCanvas,
      alpha: true,
      antialias: true
    });
    threeRenderer.setClearColor(0x000000, 0);
    threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    threeScene.add(new T3.HemisphereLight(0xffffff, 0x30343b, 2.2));
    const key: any = new T3.DirectionalLight(0xffffff, 2.6);
    key.position.set(5, 8, 6);
    threeScene.add(key);
    gltfLoader = new (GLTFLoader as any)();
  }

  function ensureThreeObject(obj: SceneObject) {
    if (!obj.url || obj.kind !== "3d" || !gltfLoader || !threeScene || threeObjects.has(obj.id) || threeLoading.has(obj.id)) return;

    const now = performance.now();
    const retryAt = threeRetryAt.get(obj.id) ?? 0;
    if (now < retryAt) return;

    threeLoading.add(obj.id);
    gltfLoader.load(
      obj.url,
      (gltf: any) => {
        const T3: any = THREE;
        const root: any = gltf.scene;
        const box: any = new T3.Box3().setFromObject(root);
        const center: any = box.getCenter(new T3.Vector3());
        const size: any = box.getSize(new T3.Vector3());
        const maxDimension = Math.max(size.x, size.y, size.z) || 1;
        root.position.sub(center);
        root.scale.setScalar(2 / maxDimension);

        const group: any = new T3.Group();
        group.add(root);
        group.visible = false;
        threeScene.add(group);
        threeObjects.set(obj.id, group);
        threeLoading.delete(obj.id);
        threeLoadAttempts.delete(obj.id);
        threeRetryAt.delete(obj.id);
      },
      undefined,
      (error: any) => {
        threeLoading.delete(obj.id);
        const attempt = (threeLoadAttempts.get(obj.id) ?? 0) + 1;
        threeLoadAttempts.set(obj.id, attempt);
        const retryDelay = Math.min(8000, 400 * Math.pow(2, Math.min(attempt - 1, 4)));
        threeRetryAt.set(obj.id, performance.now() + retryDelay);
        console.warn(`GLB load attempt ${attempt} failed for ${obj.name}; retrying in ${retryDelay}ms`, error);
      }
    );
  }

  function ensureImageOccluder(stationIndex: number, center: Vec3) {
    if (!threeScene) return null;
    const T3: any = THREE;
    let mesh: any = occluders.get(stationIndex);
    if (!mesh) {
      const geometry: any = new T3.PlaneGeometry(5.4, 5.9);
      const material: any = new T3.MeshBasicMaterial({
        colorWrite: false,
        depthWrite: true,
        depthTest: true,
        side: T3.DoubleSide
      });
      mesh = new T3.Mesh(geometry, material);
      mesh.renderOrder = -1000;
      threeScene.add(mesh);
      occluders.set(stationIndex, mesh);
    }
    mesh.position.set(center.x, center.y, center.z + 0.02);
    mesh.rotation.set(0, 0, 0);
    mesh.visible = true;
    return mesh;
  }


  if (root && canvas instanceof HTMLCanvasElement) {
    const gameCanvas: HTMLCanvasElement = canvas;
    const config = JSON.parse(root.dataset.config ?? "{}");
    const settingsStorageKey = "webrev:presentation-settings:v1";
    const assetPlacementStorageKey = "webrev:asset-placement:v1";

    function allDiscoveredAssets() {
      const result: Array<{ name: string; stationId: string }> = [];
      for (const station of Array.isArray(config.stations) ? config.stations : []) {
        const assets = Array.isArray(config.assetsByArtwork?.[station.artworkName])
          ? config.assetsByArtwork[station.artworkName]
          : [];
        for (const asset of assets) result.push({ name: asset.name, stationId: station.id });
      }
      return result;
    }

    function loadAssetPlacement(): AssetPlacementState {
      let stored: any = {};
      try {
        stored = JSON.parse(window.localStorage.getItem(assetPlacementStorageKey) ?? "{}");
      } catch {}
      const state: AssetPlacementState = {};
      for (const asset of allDiscoveredAssets()) {
        const saved = stored?.[asset.name];
        state[asset.name] = {
          hemisphere: saved?.hemisphere === "back" ? "back" : "front",
          visible: typeof saved?.visible === "boolean" ? saved.visible : true
        };
      }
      return state;
    }

    let assetPlacement = loadAssetPlacement();

    function saveAssetPlacement() {
      try {
        window.localStorage.setItem(assetPlacementStorageKey, JSON.stringify(assetPlacement));
      } catch {}
      window.dispatchEvent(new CustomEvent("webrev:asset-placement", { detail: assetPlacement }));
    }
    const defaultMinDistance = Math.max(
      0,
      Number(config.arrangement?.assetRange?.minDistanceFromCenter ?? config.arrangement?.influenceSphere?.innerRadius ?? 4.2)
    );
    const defaultMaxDistance = Math.max(
      defaultMinDistance,
      Number(config.arrangement?.assetRange?.maxDistanceFromCenter ?? config.arrangement?.influenceSphere?.radius ?? 6.4)
    );
    const settingDefaults: PresentationSettingsSnapshot = {
      camera: {
        mode:
          config.arrangement?.controls?.cameraMode === "focus" ||
          config.arrangement?.controls?.cameraMode === "free"
            ? config.arrangement.controls.cameraMode
            : "locked",
        mouseMovesCamera: Boolean(config.arrangement?.controls?.mouseMovesCamera ?? false)
      },
      assets: {
        minDistanceFromCenter: defaultMinDistance,
        maxDistanceFromCenter: defaultMaxDistance
      },
      collisions: {
        viewport: {
          enabled: Boolean(config.arrangement?.collisions?.viewport?.enabled ?? true),
          restitution: Math.max(0, Math.min(1, Number(config.arrangement?.collisions?.viewport?.restitution ?? 0.72))),
          paddingPx: Math.max(0, Number(config.arrangement?.collisions?.viewport?.paddingPx ?? 18))
        },
        sphereInside: {
          enabled: Boolean(config.arrangement?.collisions?.sphereInside?.enabled ?? false)
        }
      }
    };
    const settingsListeners = new Set<SettingsListener>();

    function cloneSettings(source: PresentationSettingsSnapshot): PresentationSettingsSnapshot {
      return {
        camera: {
          mode: source.camera.mode,
          mouseMovesCamera: Boolean(source.camera.mouseMovesCamera)
        },
        assets: {
          minDistanceFromCenter: Number(source.assets.minDistanceFromCenter),
          maxDistanceFromCenter: Number(source.assets.maxDistanceFromCenter)
        },
        collisions: {
          viewport: {
            enabled: Boolean(source.collisions.viewport.enabled),
            restitution: Number(source.collisions.viewport.restitution),
            paddingPx: Number(source.collisions.viewport.paddingPx)
          },
          sphereInside: {
            enabled: Boolean(source.collisions.sphereInside.enabled)
          }
        }
      };
    }

    function loadSettings(): PresentationSettingsSnapshot {
      try {
        const raw = window.localStorage.getItem(settingsStorageKey);
        if (!raw) return cloneSettings(settingDefaults);
        const parsed = JSON.parse(raw);
        const loadedMin = Number(parsed?.assets?.minDistanceFromCenter);
        const loadedMax = Number(parsed?.assets?.maxDistanceFromCenter);
        const minDistance = Number.isFinite(loadedMin)
          ? Math.max(0, loadedMin)
          : settingDefaults.assets.minDistanceFromCenter;
        const maxDistance = Number.isFinite(loadedMax)
          ? Math.max(minDistance, loadedMax)
          : Math.max(minDistance, settingDefaults.assets.maxDistanceFromCenter);
        return {
          camera: {
            mode:
              parsed?.camera?.mode === "focus" || parsed?.camera?.mode === "free"
                ? parsed.camera.mode
                : "locked",
            mouseMovesCamera:
              typeof parsed?.camera?.mouseMovesCamera === "boolean"
                ? parsed.camera.mouseMovesCamera
                : settingDefaults.camera.mouseMovesCamera
          },
          assets: {
            minDistanceFromCenter: minDistance,
            maxDistanceFromCenter: maxDistance
          },
          collisions: {
            viewport: {
              enabled:
                typeof parsed?.collisions?.viewport?.enabled === "boolean"
                  ? parsed.collisions.viewport.enabled
                  : settingDefaults.collisions.viewport.enabled,
              restitution: Number.isFinite(Number(parsed?.collisions?.viewport?.restitution))
                ? Math.max(0, Math.min(1, Number(parsed.collisions.viewport.restitution)))
                : settingDefaults.collisions.viewport.restitution,
              paddingPx: Number.isFinite(Number(parsed?.collisions?.viewport?.paddingPx))
                ? Math.max(0, Number(parsed.collisions.viewport.paddingPx))
                : settingDefaults.collisions.viewport.paddingPx
            },
            sphereInside: {
              enabled:
                typeof parsed?.collisions?.sphereInside?.enabled === "boolean"
                  ? parsed.collisions.sphereInside.enabled
                  : settingDefaults.collisions.sphereInside.enabled
            }
          }
        };
      } catch {
        return cloneSettings(settingDefaults);
      }
    }

    let presentationSettings = loadSettings();

    function publishSettings() {
      try {
        window.localStorage.setItem(settingsStorageKey, JSON.stringify(presentationSettings));
      } catch {}
      const snapshot = cloneSettings(presentationSettings);
      for (const listener of settingsListeners) listener(snapshot);
      window.dispatchEvent(new CustomEvent("webrev:presentation-settings", { detail: snapshot }));
      return snapshot;
    }

    window.webrevPresentationSettings = {
      get(key?: PresentationSettingKey) {
        if (key === "camera.mode") return presentationSettings.camera.mode;
        if (key === "camera.mouseMovesCamera") return presentationSettings.camera.mouseMovesCamera;
        if (key === "assets.minDistanceFromCenter") return presentationSettings.assets.minDistanceFromCenter;
        if (key === "assets.maxDistanceFromCenter") return presentationSettings.assets.maxDistanceFromCenter;
        if (key === "collisions.viewport.enabled") return presentationSettings.collisions.viewport.enabled;
        if (key === "collisions.viewport.restitution") return presentationSettings.collisions.viewport.restitution;
        if (key === "collisions.viewport.paddingPx") return presentationSettings.collisions.viewport.paddingPx;
        if (key === "collisions.sphereInside.enabled") return presentationSettings.collisions.sphereInside.enabled;
        return cloneSettings(presentationSettings);
      },
      set(key: PresentationSettingKey, value: PresentationSettingValue) {
        if (key === "camera.mode") {
          presentationSettings.camera.mode =
            value === "focus" || value === "free" ? value : "locked";
          presentationSettings.camera.mouseMovesCamera = presentationSettings.camera.mode !== "locked";
        } else if (key === "camera.mouseMovesCamera") {
          presentationSettings.camera.mouseMovesCamera = Boolean(value);
          presentationSettings.camera.mode = presentationSettings.camera.mouseMovesCamera ? "focus" : "locked";
        } else if (key === "assets.minDistanceFromCenter") {
          const next = Math.max(0, Number(value) || 0);
          presentationSettings.assets.minDistanceFromCenter = Math.min(
            next,
            presentationSettings.assets.maxDistanceFromCenter
          );
        } else if (key === "assets.maxDistanceFromCenter") {
          const next = Math.max(0, Number(value) || 0);
          presentationSettings.assets.maxDistanceFromCenter = Math.max(
            next,
            presentationSettings.assets.minDistanceFromCenter
          );
        } else if (key === "collisions.viewport.enabled") {
          presentationSettings.collisions.viewport.enabled = Boolean(value);
        } else if (key === "collisions.viewport.restitution") {
          presentationSettings.collisions.viewport.restitution = Math.max(0, Math.min(1, Number(value) || 0));
        } else if (key === "collisions.viewport.paddingPx") {
          presentationSettings.collisions.viewport.paddingPx = Math.max(0, Number(value) || 0);
        } else if (key === "collisions.sphereInside.enabled") {
          presentationSettings.collisions.sphereInside.enabled = Boolean(value);
        }
        return publishSettings();
      },
      reset(key?: PresentationSettingKey) {
        if (!key || key === "camera.mode") {
          presentationSettings.camera.mode = settingDefaults.camera.mode;
        }
        if (!key || key === "camera.mouseMovesCamera") {
          presentationSettings.camera.mouseMovesCamera = settingDefaults.camera.mouseMovesCamera;
        }
        if (!key) {
          presentationSettings.camera.mouseMovesCamera = presentationSettings.camera.mode !== "locked";
        }
        if (!key || key === "assets.minDistanceFromCenter") {
          presentationSettings.assets.minDistanceFromCenter = settingDefaults.assets.minDistanceFromCenter;
        }
        if (!key || key === "assets.maxDistanceFromCenter") {
          presentationSettings.assets.maxDistanceFromCenter = settingDefaults.assets.maxDistanceFromCenter;
        }
        if (!key || key === "collisions.viewport.enabled") {
          presentationSettings.collisions.viewport.enabled = settingDefaults.collisions.viewport.enabled;
        }
        if (!key || key === "collisions.viewport.restitution") {
          presentationSettings.collisions.viewport.restitution = settingDefaults.collisions.viewport.restitution;
        }
        if (!key || key === "collisions.viewport.paddingPx") {
          presentationSettings.collisions.viewport.paddingPx = settingDefaults.collisions.viewport.paddingPx;
        }
        if (!key || key === "collisions.sphereInside.enabled") {
          presentationSettings.collisions.sphereInside.enabled = settingDefaults.collisions.sphereInside.enabled;
        }
        return publishSettings();
      },
      subscribe(listener: SettingsListener) {
        settingsListeners.add(listener);
        listener(cloneSettings(presentationSettings));
        return () => settingsListeners.delete(listener);
      },
      listAssets(stationId?: string) {
        const allowed = new Set(
          allDiscoveredAssets()
            .filter((asset) => !stationId || asset.stationId === stationId)
            .map((asset) => asset.name)
        );
        return Object.entries(assetPlacement)
          .filter(([name]) => allowed.has(name))
          .map(([name, state]) => ({ name, ...state }));
      },
      setAssetHemisphere(name: string, hemisphere: AssetHemisphere) {
        if (!assetPlacement[name]) return;
        assetPlacement[name].hemisphere = hemisphere === "back" ? "back" : "front";
        assetPlacement[name].visible = true;
        saveAssetPlacement();
        syncAssetPlacementToLayouts();
        renderSphereSettings();
      },
      setAssetVisible(name: string, visible: boolean) {
        if (!assetPlacement[name]) return;
        assetPlacement[name].visible = Boolean(visible);
        saveAssetPlacement();
        syncAssetPlacementToLayouts();
        renderSphereSettings();
      }
    };

    const stations = Array.isArray(config.stations) ? config.stations : [];
    const assetsByArtwork = config.assetsByArtwork ?? {};
    const assetActions = config.assetActions ?? {};
    const resolvedLinks = config.resolvedLinks ?? {};
    const ctxMaybe = gameCanvas.getContext("2d");

    if (ctxMaybe && stations.length) {
      const ctx: CanvasRenderingContext2D = ctxMaybe;
      const status = document.getElementById("presentation-status");
      const rail = config.rail;
      const arrangement = config.arrangement;
      const billboard = arrangement.billboard2d ?? {};
      const motion = arrangement.motion ?? {};
      const sphere = arrangement.influenceSphere;
      const exclusion = arrangement.viewportExclusion;
      const spacing = Number(rail.stationSpacing) || 26;
      const rideSpeed = Number(rail.speed) || 7.5;
      const prismRadius = Number(rail.prismRadius) || 3.4;

      function minAssetDistance() {
        return Math.max(0, Number(presentationSettings.assets.minDistanceFromCenter) || 0);
      }

      function maxAssetDistance() {
        return Math.max(minAssetDistance(), Number(presentationSettings.assets.maxDistanceFromCenter) || 0.01);
      }

      let width = 1;
      let height = 1;
      let cameraZ = 9;
      let targetZ = stationZ(0) + 8.5;
      let arrivingAt = 0;
      let lookYaw = 0;
      let lookPitch = -0.02;
      let targetYaw = 0;
      let targetPitch = -0.02;
      let pointerX = 0;
      let pointerY = 0;
      let previous = performance.now();

      let paperOpen = 0;
      let paperTarget = 0;
      let paperTextOverride: { title?: string; body?: string } | null = null;
      let lastPaperRect: { x: number; y: number; w: number; h: number } | null = null;
      let grabbed: { stationIndex: number; object: SceneObject } | null = null;
      let dragLastX = 0;
      let dragLastY = 0;
      let dragLastTime = performance.now();
      let draggedDistance = 0;

      const layouts = stations.map((station: any, index: number) => generateLayout(station, index));
      ensureThree();
      for (const layout of layouts) {
        for (const obj of layout) ensureThreeObject(obj);
      }

      function makeAssetRow(obj: SceneObject) {
        const row = document.createElement("div");
        row.className = "sphere-asset-row";

        const name = document.createElement("span");
        name.className = "sphere-asset-name";
        name.textContent = obj.name;

        const side = document.createElement("select");
        side.className = "sphere-side-select";
        side.setAttribute("aria-label", `Placement for ${obj.name}`);
        for (const value of ["front", "back"] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = value === "front" ? "Front" : "Back";
          option.selected = obj.hemisphere === value;
          side.appendChild(option);
        }
        side.addEventListener("change", () => {
          window.webrevPresentationSettings?.setAssetHemisphere(
            obj.name,
            side.value === "back" ? "back" : "front"
          );
        });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "sphere-asset-remove";
        remove.setAttribute("aria-label", `Hide ${obj.name}`);
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          window.webrevPresentationSettings?.setAssetVisible(obj.name, false);
        });

        row.append(name, side, remove);
        return row;
      }

      function renderSphereSettings() {
        if (!frontAssetsList || !backAssetsList || !assetPicker || !sphereSizeReadout) return;
        sphereSizeReadout.textContent =
          `Sphere range: ${minAssetDistance().toFixed(1)} – ${maxAssetDistance().toFixed(1)} from image center`;

        frontAssetsList.replaceChildren();
        backAssetsList.replaceChildren();

        const currentLayout = layouts[arrivingAt] ?? [];
        const uploaded = currentLayout.filter((obj: SceneObject) => Boolean(obj.url));
        const hidden = uploaded.filter((obj: SceneObject) => obj.visible === false);

        for (const obj of uploaded.filter((obj: SceneObject) => obj.visible !== false && obj.hemisphere !== "back")) {
          frontAssetsList.appendChild(makeAssetRow(obj));
        }
        for (const obj of uploaded.filter((obj: SceneObject) => obj.visible !== false && obj.hemisphere === "back")) {
          backAssetsList.appendChild(makeAssetRow(obj));
        }

        assetPicker.replaceChildren();
        const prompt = document.createElement("option");
        prompt.value = "";
        prompt.textContent = hidden.length ? "Choose an asset…" : "All assets are displayed";
        assetPicker.appendChild(prompt);
        for (const obj of hidden) {
          const option = document.createElement("option");
          option.value = obj.name;
          option.textContent = obj.name;
          assetPicker.appendChild(option);
        }
        assetPicker.disabled = hidden.length === 0;
      }

      settingsToggle?.addEventListener("click", () => {
        if (!settingsPanel) return;
        const open = settingsPanel.hidden;
        settingsPanel.hidden = !open;
        settingsToggle.setAttribute("aria-expanded", String(open));
        if (open) renderSphereSettings();
      });
      settingsClose?.addEventListener("click", () => {
        if (!settingsPanel) return;
        settingsPanel.hidden = true;
        settingsToggle?.setAttribute("aria-expanded", "false");
      });
      assetPicker?.addEventListener("change", () => {
        const name = assetPicker.value;
        if (!name) return;
        window.webrevPresentationSettings?.setAssetHemisphere(name, "front");
        window.webrevPresentationSettings?.setAssetVisible(name, true);
        assetPicker.value = "";
      });
      window.addEventListener("webrev:presentation-settings", renderSphereSettings);
      renderSphereSettings();

      function stationZ(index: number) {
        return -18 - index * spacing;
      }

      function hashSeed(text: string, seed: number) {
        let h = seed | 0;
        for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
        return h >>> 0;
      }

      function rngFor(station: any, index: number) {
        const randomVisit = arrangement.mode === "random-every-visit";
        let state = randomVisit
          ? ((Math.random() * 0xffffffff) >>> 0)
          : hashSeed(station.artworkName ?? station.id ?? String(index), Number(arrangement.seed) || 1);

        return () => {
          state += 0x6D2B79F5;
          let t = state;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function insideProtectedViewport(p: Vec3) {
        const pad = Number(exclusion.padding) || 0;
        return (
          Math.abs(p.x) < Number(exclusion.width) * 0.5 + pad &&
          Math.abs(p.y) < Number(exclusion.height) * 0.5 + pad &&
          Math.abs(p.z) < Number(exclusion.depth) * 0.5 + pad
        );
      }

      function randomPlacement(rand: () => number): Vec3 {
        const outer = maxAssetDistance();
        const inner = Math.min(outer, minAssetDistance());
        let point: Vec3 = { x: outer, y: 0, z: 0 };

        for (let attempt = 0; attempt < 100; attempt++) {
          const radius = inner + (outer - inner) * Math.cbrt(rand());
          const theta = rand() * Math.PI * 2;
          const cosPhi = rand() * 2 - 1;
          const sinPhi = Math.sqrt(Math.max(0, 1 - cosPhi * cosPhi));
          point = {
            x: Math.cos(theta) * sinPhi * radius,
            y: cosPhi * radius,
            z: Math.sin(theta) * sinPhi * radius
          };
          if (!insideProtectedViewport(point)) return point;
        }

        return { x: outer, y: 0, z: 0 };
      }

      function resolve3dSettings(station: any) {
        const defaults = arrangement.asset3d ?? {};
        const override = station.asset3d ?? {};
        const requestedLayer = override.layer ?? defaults.layer ?? "middle";
        const layer: "near" | "middle" | "far" =
          requestedLayer === "near" || requestedLayer === "far" ? requestedLayer : "middle";
        return {
          layer,
          hideBehindImage: Boolean(override.hideBehindImage ?? defaults.hideBehindImage ?? true)
        };
      }

      function applyDepthLayer(position: Vec3, layer: "near" | "middle" | "far"): Vec3 {
        // Camera sits in front of each station along +Z, so positive local Z is nearer.
        // Near assets must stay inside a tighter screen-visible envelope because
        // perspective magnifies their x/y offsets substantially.
        if (layer === "near") {
          position.x *= 0.5;
          position.y *= 0.5;
          position.z = Math.abs(position.z) * 0.24 + maxAssetDistance() * 0.30;
        } else if (layer === "far") {
          position.z = -Math.abs(position.z) * 0.45 - maxAssetDistance() * 0.34;
        } else {
          position.z *= 0.3;
        }
        return position;
      }

      function placeUploaded3d(
        assetIndex: number,
        assetCount: number,
        layer: "near" | "middle" | "far"
      ): Vec3 {
        const count = Math.max(1, assetCount);
        const angle = -Math.PI / 2 + (assetIndex / count) * Math.PI * 2;
        const ring = Math.max(2.4, Math.min(maxAssetDistance() * 0.58, 3.6));
        const position: Vec3 = {
          x: Math.cos(angle) * ring,
          y: Math.sin(angle) * ring * 0.72,
          z: 0
        };
        return applyDepthLayer(position, layer);
      }

      function enforceHemisphere(obj: SceneObject) {
        if (!obj.url) return;
        const magnitude = Math.max(Math.abs(obj.local.z), Math.max(0.45, minAssetDistance() * 0.2));
        obj.local.z = obj.hemisphere === "back" ? -magnitude : magnitude;
        if (obj.hemisphere === "back" && obj.velocity.z > 0) obj.velocity.z *= -1;
        if (obj.hemisphere !== "back" && obj.velocity.z < 0) obj.velocity.z *= -1;
      }

      function syncAssetPlacementToLayouts() {
        if (typeof layouts === "undefined") return;
        for (const layout of layouts) {
          for (const obj of layout) {
            if (!obj.url) continue;
            const state = assetPlacement[obj.name] ?? { hemisphere: "front" as AssetHemisphere, visible: true };
            obj.hemisphere = state.hemisphere;
            obj.visible = state.visible;
            enforceHemisphere(obj);
          }
        }
      }

      function generateLayout(station: any, index: number): SceneObject[] {
        const rand = rngFor(station, index);
        const discovered = Array.isArray(assetsByArtwork[station.artworkName])
          ? assetsByArtwork[station.artworkName]
          : [];
        const requestedDisplayMode = station.assetDisplayMode ?? arrangement.assetDisplayMode;
        const displayMode = requestedDisplayMode === "assets-and-proxies"
          ? "assets-and-proxies"
          : "assets-only";
        const configuredProxyCount = Math.max(
          0,
          Math.floor(Number(arrangement.proxyCount ?? sphere.defaultObjectCount ?? 10))
        );
        const fallbackProxyCount = discovered.length === 0
          ? (configuredProxyCount || Number(sphere.defaultObjectCount) || 10)
          : 0;
        const extraProxyCount = displayMode === "assets-and-proxies"
          ? configuredProxyCount
          : fallbackProxyCount;
        const sceneItems = [
          ...discovered.map((asset: any) => ({ asset })),
          ...Array.from({ length: extraProxyCount }, () => ({ asset: undefined }))
        ];
        const result: SceneObject[] = [];
        const threeSettings = resolve3dSettings(station);
        const uploaded3dCount = discovered.filter((asset: any) => asset?.kind === "3d").length;
        let uploaded3dIndex = 0;

        for (let i = 0; i < sceneItems.length; i++) {
          const asset = sceneItems[i].asset;
          const kind: "2d" | "3d" = asset?.kind === "2d" ? "2d" : "3d";
          const obj: SceneObject = {
            id: `${station.id}-asset-${i}`,
            name: asset?.name ?? `${station.artworkName}-proxy-${i + 1}`,
            kind,
            url: asset?.url,
            local: kind === "3d" && asset
              ? placeUploaded3d(uploaded3dIndex++, uploaded3dCount, threeSettings.layer)
              : kind === "3d"
                ? applyDepthLayer(randomPlacement(rand), threeSettings.layer)
                : randomPlacement(rand),
            velocity: { x: 0, y: 0, z: 0 },
            size: 0.42 + rand() * 0.7,
            shape: Math.floor(rand() * 4),
            spin: rand() * Math.PI * 2,
            spinVelocity: (rand() - 0.5) * 0.28,
            phase: rand() * Math.PI * 2,
            action: asset ? assetActions[asset.name] : undefined,
            depthLayer: kind === "3d" ? threeSettings.layer : undefined,
            hideBehindImage: kind === "3d" ? threeSettings.hideBehindImage : undefined,
            hemisphere: asset ? (assetPlacement[asset.name]?.hemisphere ?? "front") : "front",
            visible: asset ? (assetPlacement[asset.name]?.visible ?? true) : true
          };
          enforceHemisphere(obj);

          if (kind === "2d" && asset?.url) {
            const image = new Image();
            image.src = asset.url;
            obj.image = image;
          }

          result.push(obj);
        }

        return result;
      }

      function twistAt(z: number) {
        return Math.sin(z * 0.035) * 0.58 + Math.sin(z * 0.013) * 0.22;
      }

      function topFacePoint(z: number): Vec3 {
        const twist = twistAt(z);
        return {
          x: Math.sin(twist) * prismRadius,
          y: Math.cos(twist) * prismRadius,
          z
        };
      }

      function stationCenter(index: number): Vec3 {
        const z = stationZ(index);
        const railPoint = topFacePoint(z);
        return { x: railPoint.x, y: railPoint.y + 0.9, z };
      }

      function resize() {
        const rect = gameCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        const pixelW = Math.floor(width * dpr);
        const pixelH = Math.floor(height * dpr);

        if (gameCanvas.width !== pixelW || gameCanvas.height !== pixelH) {
          gameCanvas.width = pixelW;
          gameCanvas.height = pixelH;
        }

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (threeRenderer && threeCamera) {
          threeRenderer.setPixelRatio(dpr);
          threeRenderer.setSize(width, height, false);
          const focal = Math.min(width, height) * 0.92;
          threeCamera.aspect = width / Math.max(1, height);
          threeCamera.fov = 2 * Math.atan(height / (2 * focal)) * 180 / Math.PI;
          threeCamera.updateProjectionMatrix();
        }
      }

      function cameraPosition(): Vec3 {
        const p = topFacePoint(cameraZ);
        return { x: p.x, y: p.y + 0.35, z: cameraZ };
      }

      function project(point: Vec3): Projected | null {
        const camera = cameraPosition();
        const dx = point.x - camera.x;
        const dy = point.y - camera.y;
        const dz = point.z - camera.z;

        const cy = Math.cos(-lookYaw);
        const sy = Math.sin(-lookYaw);
        const x1 = dx * cy - dz * sy;
        const z1 = dx * sy + dz * cy;

        const cp = Math.cos(-lookPitch);
        const sp = Math.sin(-lookPitch);
        const y2 = dy * cp - z1 * sp;
        const z2 = dy * sp + z1 * cp;

        const depth = -z2;
        if (depth < 0.35) return null;

        const focal = Math.min(width, height) * 0.92;
        const scale = focal / depth;
        return {
          x: width * 0.5 + x1 * scale,
          y: height * 0.5 - y2 * scale,
          depth,
          scale
        };
      }

      function drawBackground() {
        const g = ctx.createRadialGradient(
          width * 0.5, height * 0.42, 10,
          width * 0.5, height * 0.5, Math.max(width, height) * 0.78
        );
        g.addColorStop(0, "#18202b");
        g.addColorStop(0.45, "#090d13");
        g.addColorStop(1, "#020304");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = "rgba(255,255,255,.14)";
        for (let i = 0; i < 42; i++) {
          const x = (i * 193.1) % width;
          const y = (i * 91.7) % height;
          ctx.fillRect(x, y, i % 4 === 0 ? 1.5 : 1, i % 4 === 0 ? 1.5 : 1);
        }
      }

      function drawRail() {
        const start = Math.floor(cameraZ / 4) * 4 + 8;
        const points: Projected[] = [];

        for (let z = start; z >= cameraZ - spacing * (stations.length + 2); z -= 1.2) {
          const p = project(topFacePoint(z));
          if (p) points.push(p);
        }

        if (points.length > 1) {
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
          ctx.strokeStyle = "rgba(232,218,192,.68)";
          ctx.lineWidth = 1.25;
          ctx.stroke();
        }
      }

      function themeColors(theme: string) {
        if (theme === "blue") return ["#203954", "#7ea6d7", "#0d1520"];
        if (theme === "rose") return ["#512937", "#c77f94", "#180d13"];
        return ["#5a3a22", "#d5a268", "#1b120c"];
      }

      function constrainToSphere(obj: SceneObject) {
        const p = obj.local;
        const d = Math.hypot(p.x, p.y, p.z);
        const min = minAssetDistance();
        const max = Math.max(min, maxAssetDistance() - obj.size * 0.35);
        if (d > 0.0001 && (d > max || d < min)) {
          const target = d > max ? max : min;
          const nx = p.x / d, ny = p.y / d, nz = p.z / d;
          obj.local.x = nx * target;
          obj.local.y = ny * target;
          obj.local.z = nz * target;
          const vn = obj.velocity.x * nx + obj.velocity.y * ny + obj.velocity.z * nz;
          const restitution = Number(motion.boundaryRestitution) || 0.5;
          if ((d > max && vn > 0) || (d < min && vn < 0)) {
            obj.velocity.x -= (1 + restitution) * vn * nx;
            obj.velocity.y -= (1 + restitution) * vn * ny;
            obj.velocity.z -= (1 + restitution) * vn * nz;
          }
        }
      }

      function constrainToViewport(center: Vec3, obj: SceneObject) {
        if (!presentationSettings.collisions.viewport.enabled) return;

        const projected = project({
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        });
        if (!projected) return;

        const baseRadius = Math.max(8, obj.size * projected.scale);
        // 3D meshes can extend well beyond the nominal object center because their
        // normalized bounds are later scaled in WebGL. Use a conservative screen
        // radius so the complete model, not just its anchor point, stays visible.
        const radius = obj.kind === "3d"
          ? Math.max(baseRadius * 2.15, 28)
          : baseRadius;
        const pad = presentationSettings.collisions.viewport.paddingPx;
        const minX = pad + radius;
        const maxX = width - pad - radius;
        const minY = pad + radius;
        const maxY = height - pad - radius;
        const restitution = presentationSettings.collisions.viewport.restitution;

        let correctionX = 0;
        let correctionY = 0;

        if (projected.x < minX) correctionX = minX - projected.x;
        else if (projected.x > maxX) correctionX = maxX - projected.x;

        if (projected.y < minY) correctionY = minY - projected.y;
        else if (projected.y > maxY) correctionY = maxY - projected.y;

        if (correctionX === 0 && correctionY === 0) return;

        // Convert screen-space correction back into local world-space at this depth.
        const worldPerPixel = 1 / Math.max(projected.scale, 0.0001);
        obj.local.x += correctionX * worldPerPixel;
        obj.local.y -= correctionY * worldPerPixel;

        // Perspective can slightly change after the first correction. Clamp once
        // more against the same screen envelope so fast-moving objects cannot
        // tunnel past the edge between frames.
        const corrected = project({
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        });
        if (corrected) {
          const correctedRadius = obj.kind === "3d"
            ? Math.max(Math.max(8, obj.size * corrected.scale) * 2.15, 28)
            : Math.max(8, obj.size * corrected.scale);
          const correctedMinX = pad + correctedRadius;
          const correctedMaxX = width - pad - correctedRadius;
          const correctedMinY = pad + correctedRadius;
          const correctedMaxY = height - pad - correctedRadius;
          const correctedWorldPerPixel = 1 / Math.max(corrected.scale, 0.0001);

          if (corrected.x < correctedMinX) obj.local.x += (correctedMinX - corrected.x) * correctedWorldPerPixel;
          else if (corrected.x > correctedMaxX) obj.local.x += (correctedMaxX - corrected.x) * correctedWorldPerPixel;

          if (corrected.y < correctedMinY) obj.local.y -= (correctedMinY - corrected.y) * correctedWorldPerPixel;
          else if (corrected.y > correctedMaxY) obj.local.y -= (correctedMaxY - corrected.y) * correctedWorldPerPixel;
        }

        if (correctionX !== 0) obj.velocity.x *= -restitution;
        if (correctionY !== 0) obj.velocity.y *= -restitution;
      }

      function updateObjects(now: number, dt: number) {
        const damping = Math.pow(Number(motion.tossDamping) || 0.992, dt * 60);
        const floatStrength = Number(motion.floatStrength) || 0.08;
        const floatSpeed = Number(motion.floatSpeed) || 0.22;

        for (let stationIndex = 0; stationIndex < layouts.length; stationIndex++) {
          const layout = layouts[stationIndex];
          const center = stationCenter(stationIndex);
          for (const obj of layout) {
            if (obj.visible === false) continue;
            if (grabbed?.object === obj) continue;
            obj.velocity.x *= damping;
            obj.velocity.y *= damping;
            obj.velocity.z *= damping;

            const t = now * 0.001 * floatSpeed + obj.phase;
            obj.velocity.y += Math.sin(t) * floatStrength * dt;
            obj.velocity.x += Math.cos(t * 0.77) * floatStrength * 0.42 * dt;

            obj.local.x += obj.velocity.x * dt;
            obj.local.y += obj.velocity.y * dt;
            obj.local.z += obj.velocity.z * dt;
            enforceHemisphere(obj);

            if (obj.kind === "3d") obj.spin += obj.spinVelocity * dt;
            if (presentationSettings.collisions.sphereInside.enabled) {
              constrainToSphere(obj);
            }
            constrainToViewport(center, obj);
          }
        }
      }

      function drawSceneObject(center: Vec3, obj: SceneObject, alpha: number, now: number) {
        if (obj.visible === false) {
          obj.lastScreen = undefined;
          return;
        }
        const world = {
          x: center.x + obj.local.x,
          y: center.y + obj.local.y,
          z: center.z + obj.local.z
        };
        const p = project(world);
        if (!p || p.depth > 60) {
          obj.lastScreen = undefined;
          return;
        }

        const size = Math.max(8, obj.size * p.scale);
        obj.lastScreen = { x: p.x, y: p.y, radius: size * 1.15, depth: p.depth };

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.globalAlpha = alpha;

        if (obj.kind === "2d") {
          const wobbleDeg = Number(billboard.wobbleDegrees) || 1.4;
          const wobbleSpeed = Number(billboard.wobbleSpeed) || 0.28;
          const maxYaw = Number(billboard.maxYawDegrees) || 5;
          const wobble = Math.sin(now * 0.001 * wobbleSpeed + obj.phase) * wobbleDeg;
          const tossTilt = Math.max(-maxYaw, Math.min(maxYaw, obj.velocity.x * 1.4));
          const rotation = (wobble + tossTilt) * Math.PI / 180;
          ctx.rotate(rotation);

          if (obj.image?.complete && obj.image.naturalWidth > 0) {
            const aspect = obj.image.naturalWidth / obj.image.naturalHeight;
            const h = size * 1.7;
            const w = h * aspect;
            ctx.drawImage(obj.image, -w / 2, -h / 2, w, h);
            ctx.strokeStyle = "rgba(255,255,255,.25)";
            ctx.strokeRect(-w / 2, -h / 2, w, h);
          } else {
            ctx.fillStyle = "rgba(225,232,244,.88)";
            ctx.fillRect(-size, -size * .72, size * 2, size * 1.44);
            ctx.strokeStyle = "rgba(255,255,255,.28)";
            ctx.strokeRect(-size, -size * .72, size * 2, size * 1.44);
          }
        } else if (obj.url) {
          ensureThreeObject(obj);
          const model = threeObjects.get(obj.id);
          if (model) {
            model.visible = true;
            model.position.set(world.x, world.y, world.z);
            model.rotation.set(0, obj.spin, 0);
            model.scale.setScalar(obj.size);
          }
        } else {
          // No uploaded 3D asset exists for this slot, so render a mathematical
          // proxy placeholder. Uploaded GLB/GLTF assets are rendered by Three.js.
          ctx.rotate(obj.spin);
          if (obj.shape === 0) {
            const g = ctx.createRadialGradient(-size * .2, -size * .25, 0, 0, 0, size);
            g.addColorStop(0, "#d9e4f2");
            g.addColorStop(1, "#26303e");
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.fill();
          } else if (obj.shape === 1) {
            ctx.fillStyle = "#4d5968";
            ctx.fillRect(-size, -size * .6, size * 2, size * 1.2);
          } else if (obj.shape === 2) {
            ctx.strokeStyle = "rgba(198,211,226,.72)";
            ctx.lineWidth = Math.max(1, size * .16);
            ctx.beginPath();
            ctx.arc(0, 0, size, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            ctx.fillStyle = "#747b85";
            ctx.beginPath();
            ctx.moveTo(0, -size);
            ctx.lineTo(size * .82, size * .72);
            ctx.lineTo(-size * .82, size * .72);
            ctx.closePath();
            ctx.fill();
          }
        }

        if (obj.action) {
          ctx.strokeStyle = "rgba(255,255,255,.34)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(0, 0, size * 1.22, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.restore();
      }

      function wrapText(text: string, x: number, y: number, maxWidth: number, lineHeight: number) {
        const words = String(text).split(/\s+/);
        let line = "";
        let yy = y;
        for (const word of words) {
          const test = line ? `${line} ${word}` : word;
          if (ctx.measureText(test).width > maxWidth && line) {
            ctx.fillText(line, x, yy);
            line = word;
            yy += lineHeight;
          } else {
            line = test;
          }
        }
        if (line) ctx.fillText(line, x, yy);
      }

      function drawStation(index: number, now: number) {
        const station = stations[index];
        const center = stationCenter(index);
        const cp = project(center);
        if (!cp || cp.depth > 54) return;

        const alpha = Math.max(.12, Math.min(1, 1 - cp.depth / 60));
        const station3dSettings = resolve3dSettings(station);
        const hasVisibleBackAsset = layouts[index].some(
          (obj: SceneObject) => obj.url && obj.visible !== false && obj.hemisphere === "back"
        );
        if (station3dSettings.hideBehindImage || hasVisibleBackAsset) ensureImageOccluder(index, center);
        for (const obj of layouts[index]) drawSceneObject(center, obj, alpha * .84, now);

        const colors = themeColors(station.theme);
        const scale = cp.scale;
        const current = index === arrivingAt;
        const lift = current ? paperOpen * 0.85 * scale : 0;

        const imageW = 5.4 * scale;
        const imageH = 5.9 * scale;
        const imageX = cp.x - imageW * .5;
        const imageY = cp.y - imageH * .5 - lift;

        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = "#141414";
        ctx.fillRect(imageX - 10, imageY - 10, imageW + 20, imageH + 20);

        const art = ctx.createLinearGradient(imageX, imageY, imageX + imageW, imageY + imageH);
        art.addColorStop(0, colors[0]);
        art.addColorStop(.52, colors[1]);
        art.addColorStop(1, colors[2]);
        ctx.fillStyle = art;
        ctx.fillRect(imageX, imageY, imageW, imageH);

        ctx.fillStyle = "rgba(255,255,255,.86)";
        ctx.font = `${Math.max(11, Math.min(22, scale * .24))}px ui-sans-serif, system-ui`;
        ctx.textAlign = "left";
        ctx.fillText(station.label, imageX + 16, imageY + imageH - 18);

        // The paper is always present. Closed = perpendicular/edge-on to the image.
        const open = current ? paperOpen : 0;
        const paperW = 5.0 * scale;
        const paperFullH = 3.15 * scale;
        const paperClosedH = Math.max(8, paperFullH * .10);
        const paperH = paperClosedH + (paperFullH - paperClosedH) * open;
        const paperX = cp.x - paperW * .5;
        const paperY = cp.y + imageH * .25 - open * .18 * scale;

        ctx.fillStyle = "#e9e3d7";
        ctx.fillRect(paperX, paperY, paperW, paperH);
        ctx.strokeStyle = "rgba(90,80,68,.35)";
        ctx.strokeRect(paperX, paperY, paperW, paperH);

        if (current) {
          lastPaperRect = {
            x: paperX,
            y: paperY - Math.max(8, paperClosedH),
            w: paperW,
            h: Math.max(paperH, 24)
          };
        }

        if (open > .16) {
          const stationText = paperTextOverride ?? station.text;
          ctx.globalAlpha = alpha * Math.min(1, (open - .16) / .5);
          ctx.fillStyle = "#23211f";
          ctx.font = `600 ${Math.max(10, Math.min(19, scale * .21))}px ui-sans-serif, system-ui`;
          wrapText(stationText.title ?? "", paperX + 18, paperY + 30, paperW - 36, 24);
          ctx.fillStyle = "#514d48";
          ctx.font = `${Math.max(9, Math.min(15, scale * .15))}px ui-sans-serif, system-ui`;
          wrapText(stationText.body ?? "", paperX + 18, paperY + Math.max(62, scale * .66), paperW - 36, 19);
        }

        ctx.restore();
      }

      function arrived() {
        return Math.abs(cameraZ - targetZ) < 0.08;
      }

      function requestStation(index: number) {
        arrivingAt = Math.max(0, Math.min(stations.length - 1, index));
        targetZ = stationZ(arrivingAt) + 8.5;
        paperOpen = 0;
        paperTarget = 0;
        paperTextOverride = null;
        lastPaperRect = null;
        status && (status.textContent = `Traveling to ${stations[arrivingAt].label}`);
        renderSphereSettings();
      }

      function executeAction(action: AssetAction | undefined) {
        if (!action) return;
        if (action.type === "station") {
          const index = stations.findIndex((station: any) => station.id === action.stationId);
          if (index >= 0) requestStation(index);
          return;
        }
        if (action.type === "link") {
          const destination = resolvedLinks[action.linkKey];
          if (typeof destination === "string") window.location.assign(destination);
          return;
        }
        if (action.type === "url") {
          if (typeof action.url === "string") window.location.assign(action.url);
          return;
        }
        if (action.type === "text") {
          paperTextOverride = { title: action.title, body: action.body };
          paperTarget = 1;
        }
      }

      function findHitObject(x: number, y: number) {
        const objects = layouts[arrivingAt]
          .filter((obj: SceneObject) => obj.visible !== false && obj.lastScreen)
          .sort((a: SceneObject, b: SceneObject) => (a.lastScreen?.depth ?? 999) - (b.lastScreen?.depth ?? 999));

        for (const obj of objects) {
          const s = obj.lastScreen;
          if (!s) continue;
          if (Math.hypot(x - s.x, y - s.y) <= s.radius) return obj;
        }
        return null;
      }

      function update(now: number, dt: number) {
        if (presentationSettings.camera.mode === "locked") {
          targetYaw = 0;
          targetPitch = -0.02;
        }

        const dz = targetZ - cameraZ;
        if (Math.abs(dz) > 0.04) {
          cameraZ += Math.sign(dz) * Math.min(Math.abs(dz), rideSpeed * dt);
        } else {
          cameraZ = targetZ;
        }

        paperOpen += (paperTarget - paperOpen) * Math.min(1, dt * 4.0);
        lookYaw += (targetYaw - lookYaw) * Math.min(1, dt * 4.0);
        lookPitch += (targetPitch - lookPitch) * Math.min(1, dt * 4.0);
        updateObjects(now, dt);
      }

      function drawHud() {
        ctx.save();
        ctx.fillStyle = "rgba(255,255,255,.88)";
        ctx.font = "600 14px ui-sans-serif, system-ui";
        ctx.fillText("Do It Your Way", 24, 30);
        ctx.fillStyle = "rgba(255,255,255,.48)";
        ctx.font = "12px ui-sans-serif, system-ui";
        ctx.fillText("PRISM RAIL / TOP FACE", 24, 50);

        const mouseHint =
          presentationSettings.camera.mode === "locked"
            ? ""
            : presentationSettings.camera.mode === "focus"
              ? " · move mouse to look"
              : " · move mouse for free look";
        const hint = arrived()
          ? `Click the paper to present it · drag or toss floating objects${mouseHint} · ← → ride`
          : "Riding the thread…";

        ctx.textAlign = "center";
        ctx.fillText(hint, width * .5, height - 24);
        ctx.textAlign = "right";
        ctx.fillText(`${arrivingAt + 1} / ${stations.length}`, width - 24, 30);
        ctx.restore();
      }

      function render(now: number) {
        resize();
        const dt = Math.min((now - previous) / 1000, 1 / 30);
        previous = now;
        update(now, dt);

        lastPaperRect = null;
        for (const model of threeObjects.values()) model.visible = false;
        for (const occluder of occluders.values()) occluder.visible = false;
        for (const layout of layouts) {
          for (const obj of layout) obj.lastScreen = undefined;
        }

        drawBackground();
        drawRail();

        const drawOrder = stations
          .map((_: any, index: number) => index)
          .sort((a: number, b: number) => stationZ(a) - stationZ(b));

        for (const index of drawOrder) drawStation(index, now);

        if (threeRenderer && threeScene && threeCamera) {
          const cam = cameraPosition();
          threeCamera.position.set(cam.x, cam.y, cam.z);
          threeCamera.rotation.order = "YXZ";
          threeCamera.rotation.set(lookPitch, lookYaw, 0);
          threeRenderer.render(threeScene, threeCamera);
        }

        const vignette = ctx.createRadialGradient(
          width * .5, height * .5, Math.min(width, height) * .25,
          width * .5, height * .5, Math.max(width, height) * .72
        );
        vignette.addColorStop(0, "rgba(0,0,0,0)");
        vignette.addColorStop(1, "rgba(0,0,0,.6)");
        ctx.fillStyle = vignette;
        ctx.fillRect(0, 0, width, height);

        drawHud();
        requestAnimationFrame(render);
      }

      function pointIn(rect: { x: number; y: number; w: number; h: number } | null, x: number, y: number) {
        return !!rect && x >= rect.x && x <= rect.x + rect.w && y >= rect.y && y <= rect.y + rect.h;
      }

      gameCanvas.addEventListener("pointerdown", (event) => {
        if (!arrived()) return;
        const rect = gameCanvas.getBoundingClientRect();
        pointerX = event.clientX - rect.left;
        pointerY = event.clientY - rect.top;

        const obj = findHitObject(pointerX, pointerY);
        if (obj) {
          grabbed = { stationIndex: arrivingAt, object: obj };
          dragLastX = pointerX;
          dragLastY = pointerY;
          dragLastTime = performance.now();
          draggedDistance = 0;
          gameCanvas.setPointerCapture(event.pointerId);
        }
      });

      gameCanvas.addEventListener("pointermove", (event) => {
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        pointerX = x;
        pointerY = y;

        if (grabbed) {
          const now = performance.now();
          const dt = Math.max((now - dragLastTime) / 1000, 0.001);
          const dx = x - dragLastX;
          const dy = y - dragLastY;
          const obj = grabbed.object;
          const sensitivity = 0.012;
          obj.local.x += dx * sensitivity;
          obj.local.y -= dy * sensitivity;

          const maxToss = Number(motion.maxTossSpeed) || 2.6;
          obj.velocity.x = Math.max(-maxToss, Math.min(maxToss, (dx / dt) * 0.0025));
          obj.velocity.y = Math.max(-maxToss, Math.min(maxToss, (-dy / dt) * 0.0025));
          draggedDistance += Math.hypot(dx, dy);
          if (presentationSettings.collisions.sphereInside.enabled) {
            constrainToSphere(obj);
          }
          constrainToViewport(stationCenter(grabbed.stationIndex), obj);

          dragLastX = x;
          dragLastY = y;
          dragLastTime = now;
          gameCanvas.style.cursor = "grabbing";
          return;
        }

        if (presentationSettings.camera.mode !== "locked") {
          const nx = x / Math.max(1, rect.width) - .5;
          const ny = y / Math.max(1, rect.height) - .5;

          if (presentationSettings.camera.mode === "focus") {
            // Limited look mode: keep the center image inside the viewport.
            targetYaw = nx * .34;
            targetPitch = -ny * .20;
          } else {
            // Free mode: full yaw rotation and a wide pitch range.
            targetYaw = nx * Math.PI * 2;
            targetPitch = Math.max(
              -Math.PI * 0.49,
              Math.min(Math.PI * 0.49, -ny * Math.PI)
            );
          }
        }

        const hover = findHitObject(x, y);
        gameCanvas.style.cursor = hover || pointIn(lastPaperRect, x, y) ? "pointer" : "crosshair";
      });

      function releasePointer(event: PointerEvent) {
        if (!grabbed) return;
        const obj = grabbed.object;
        const wasClick = draggedDistance < 6;
        grabbed = null;
        if (gameCanvas.hasPointerCapture(event.pointerId)) gameCanvas.releasePointerCapture(event.pointerId);
        if (wasClick) executeAction(obj.action);
      }

      gameCanvas.addEventListener("pointerup", releasePointer);
      gameCanvas.addEventListener("pointercancel", releasePointer);

      gameCanvas.addEventListener("pointerleave", () => {
        if (!grabbed && presentationSettings.camera.mode === "focus") {
          targetYaw = 0;
          targetPitch = -0.02;
        }
      });

      gameCanvas.addEventListener("click", (event) => {
        if (!arrived() || draggedDistance >= 6) return;
        const rect = gameCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        if (findHitObject(x, y)) return;

        if (pointIn(lastPaperRect, x, y)) {
          paperTarget = paperTarget > .5 ? 0 : 1;
        }
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") {
          event.preventDefault();
          requestStation(Math.min(stations.length - 1, arrivingAt + 1));
        }
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          requestStation(Math.max(0, arrivingAt - 1));
        }
        if (event.key === "Home") requestStation(0);
      });

      requestStation(0);
      requestAnimationFrame(render);
    }
  }
</script>

