---
import { resolveLink } from "@webrev/core";
import linksConfig from "../../../../config/links.json";

const href = (key: keyof typeof linksConfig.links) =>
  resolveLink(linksConfig, key, import.meta.env.BASE_URL);

const cards = [
  ["Revision identity", "Every build knows what it is."],
  ["Inspectable", "Structured state for humans and agents."],
  ["Replaceable", "Providers sit behind explicit contracts."],
  ["Rewindable", "Known-good revisions stay addressable."]
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>WebRev</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background:#050608; color:#f7f7f4; }
      body { margin:0; min-height:100vh; background:radial-gradient(circle at 50% 10%, #1a2030 0, #090b10 34%, #050608 70%); }
      main { width:min(1100px, calc(100% - 32px)); margin:auto; padding:96px 0; }
      .eyebrow { letter-spacing:.2em; text-transform:uppercase; opacity:.6; font-size:.72rem; }
      h1 { font-size:clamp(3.4rem, 10vw, 8rem); line-height:.9; margin:.2em 0; letter-spacing:-.065em; }
      p { color:#b8bdc7; font-size:1.1rem; line-height:1.7; max-width:760px; }
      .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; margin-top:48px; }
      article { min-height:160px; padding:22px; border:1px solid rgba(255,255,255,.1); border-radius:24px; background:rgba(255,255,255,.035); backdrop-filter:blur(16px); }
      article h2 { font-size:1rem; }
      .showcase-links { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
      .play { display:inline-flex; align-items:center; gap:10px; padding:14px 18px; border:1px solid rgba(255,255,255,.16); border-radius:999px; color:#fff; text-decoration:none; background:rgba(255,255,255,.05); }
      .play.secondary { background:rgba(255,255,255,.025); }
      a { color:#fff; }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">WebRev / experimental foundation</div>
      <h1>Build forward.<br/>Rewind safely.</h1>
      <p>WebRev is an agent-first revision layer for websites and web applications. Build something alive, inspect what is running, and keep known-good revisions within reach.</p>

      <div class="showcase-links">
        <a class="play" href={href("world")}>Play The World in 3D →</a>
        <a class="play secondary" href={href("uniquenessRewarded")}>Design it Your Way →</a>
      </div>

      <div class="grid">
        {cards.map(([title, body]) => <article><h2>{title}</h2><p>{body}</p></article>)}
      </div>
    </main>
  </body>
</html>
